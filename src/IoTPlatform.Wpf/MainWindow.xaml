<Window x:Class="IoTPlatform.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniConnect IoT Platform"
        Height="{Binding AppWindowHeight}"
        Width="{Binding AppWindowWidth}"
        MinHeight="{Binding AppWindowMinHeight}"
        MinWidth="{Binding AppWindowMinWidth}"
        MaxHeight="{Binding AppWindowMaxHeight}"
        MaxWidth="{Binding AppWindowMaxWidth}"
        ResizeMode="{Binding AppResizeMode}"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/OmniConnectLogo.ico">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Visibility="{Binding UnauthenticatedVisibility}">
            <Border Background="{StaticResource SurfaceBrush}"
                    Padding="24">
                <StackPanel Width="320" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="Assets/OmniConnectLogo.png"
                           Width="68"
                           Height="68"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="15"
                                              Color="#2563EB"
                                              Opacity="0.25"
                                              ShadowDepth="5"
                                              Direction="270" />
                        </Image.Effect>
                    </Image>

                    <TextBlock Text="OmniConnect"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding AuthSubtitle}"
                               Foreground="{StaticResource MutedInkBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,4,0,20" />

                    <Border Height="44"
                            Margin="0,4,0,12"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="{Binding RegisterFieldVisibility}">
                        <Grid>
                            <TextBox x:Name="AuthUsernameTextBox"
                                     Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="16,0"
                                     Margin="0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     TextChanged="AuthUsernameTextBox_OnTextChanged" />
                            <TextBlock x:Name="UsernamePlaceholder"
                                       Text="*Username"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       Margin="16,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Opacity="0.72" />
                        </Grid>
                    </Border>

                    <Border Height="44"
                            Margin="0,4,0,12"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid>
                            <TextBox x:Name="AuthEmailTextBox"
                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="16,0"
                                     Margin="0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     TextChanged="AuthEmailTextBox_OnTextChanged" />
                            <TextBlock x:Name="EmailPlaceholder"
                                       Text="*Email"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       Margin="16,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Opacity="0.72" />
                        </Grid>
                    </Border>

                    <Border Height="44"
                            Margin="0,4,0,12"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid>
                            <PasswordBox x:Name="AuthPasswordBox"
                                         Padding="16,0,44,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         PasswordChanged="AuthPasswordBox_OnPasswordChanged" />
                            <TextBox x:Name="AuthPasswordTextBox"
                                     Padding="16,0,44,0"
                                     Margin="0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     TextChanged="AuthPasswordTextBox_OnTextChanged"
                                     Visibility="Collapsed" />
                            <TextBlock x:Name="PasswordPlaceholder"
                                       Text="*Password"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       Margin="16,0,44,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Opacity="0.72" />
                            <Button x:Name="PasswordVisibilityButton"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Margin="0,0,8,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Foreground="{StaticResource MutedInkBrush}"
                                    Click="PasswordVisibilityButton_OnClick">
                                <Grid Width="18" Height="18">
                                    <TextBlock x:Name="PasswordVisibilityIcon"
                                               Text="&#xE890;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="15"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Line x:Name="PasswordVisibilitySlash"
                                          X1="2"
                                          Y1="16"
                                          X2="16"
                                          Y2="2"
                                          Stroke="{StaticResource MutedInkBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>

                    <Button Content="{Binding AuthPrimaryButtonText}"
                            Command="{Binding SubmitAuthCommand}"
                            HorizontalAlignment="Stretch"
                            Height="44"
                            Margin="0,6,0,14" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding AuthSwitchPrefix}"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   VerticalAlignment="Center" />
                        <Button Content="{Binding AuthSwitchAction}"
                                Command="{Binding ToggleAuthModeCommand}"
                                Style="{StaticResource LinkButton}"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Visibility="{Binding AuthenticatedVisibility}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,0,1,0"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="{Binding SidebarHeaderMargin}">
                        <Grid Margin="0,0,0,26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="Assets/OmniConnectLogo.png"
                                   Width="44"
                                   Height="44"
                                   Margin="0,0,12,0"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Effect>
                                    <DropShadowEffect BlurRadius="15"
                                                      Color="#2563EB"
                                                      Opacity="0.25"
                                                      ShadowDepth="5"
                                                      Direction="270" />
                                </Image.Effect>
                            </Image>
                            <StackPanel Grid.Column="1" Visibility="{Binding SidebarTextVisibility}">
                                <TextBlock Text="OmniConnect" FontSize="17" FontWeight="Bold" />
                                <TextBlock Text="SmartHome Platform" Foreground="{StaticResource MutedInkBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="{Binding SidebarNavMargin}">
                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Home"
                                Background="{Binding HomeNavBackground}"
                                Foreground="{Binding HomeNavForeground}"
                                Padding="{Binding SidebarNavPadding}"
                                Tag="{Binding HomeNavRailOpacity}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0"
                                         Width="19"
                                         Height="19"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconHouseGeometry}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Style="{StaticResource LucidePath}" />
                                </Viewbox>
                                <TextBlock Grid.Column="1"
                                           Text="Home"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding SidebarTextVisibility}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Automation"
                                Background="{Binding AutomationNavBackground}"
                                Foreground="{Binding AutomationNavForeground}"
                                Padding="{Binding SidebarNavPadding}"
                                Tag="{Binding AutomationNavRailOpacity}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0"
                                         Width="19"
                                         Height="19"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconWorkflowGeometry}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Style="{StaticResource LucidePath}" />
                                </Viewbox>
                                <TextBlock Grid.Column="1"
                                           Text="Automation"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding SidebarTextVisibility}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Notifications"
                                Background="{Binding NotificationsNavBackground}"
                                Foreground="{Binding NotificationsNavForeground}"
                                Padding="{Binding SidebarNavPadding}"
                                Tag="{Binding NotificationsNavRailOpacity}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0"
                                         Width="19"
                                         Height="19"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconBellGeometry}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Style="{StaticResource LucidePath}" />
                                </Viewbox>
                                <TextBlock Grid.Column="1"
                                           Text="Alerts"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding SidebarTextVisibility}" />
                                <Border Grid.Column="2"
                                        MinWidth="20"
                                        Height="20"
                                        Background="{StaticResource PrimaryBrush}"
                                        CornerRadius="10"
                                        Padding="5,0"
                                        Visibility="{Binding SidebarUnreadNotificationBadgeVisibility}">
                                    <TextBlock Text="{Binding UnreadNotificationBadgeText}"
                                               Foreground="White"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>

                        <Border Height="1" Background="{StaticResource BorderBrushSoft}" Margin="4,18,4,18" />
                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Settings"
                                Background="{Binding SettingsNavBackground}"
                                Foreground="{Binding SettingsNavForeground}"
                                Padding="{Binding SidebarNavPadding}"
                                Tag="{Binding SettingsNavRailOpacity}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0"
                                         Width="19"
                                         Height="19"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconSettingsGeometry}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Style="{StaticResource LucidePath}" />
                                </Viewbox>
                                <TextBlock Grid.Column="1"
                                           Text="Settings"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding SidebarTextVisibility}" />
                                <TextBlock Grid.Column="2"
                                           Text="&#xE76C;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding SidebarTextVisibility}" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="{Binding SidebarFooterMargin}">
                        <Border Height="1" Background="{StaticResource BorderBrushSoft}" Margin="0,0,0,18" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="38"
                                    Height="38"
                                    Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="19"
                                    Margin="0,0,10,0">
                                <TextBlock Text="AU"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Visibility="{Binding SidebarTextVisibility}">
                                <TextBlock Text="Admin User" FontWeight="SemiBold" />
                                <TextBlock Text="Cloud account"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           FontSize="12" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Command="{Binding LogoutCommand}"
                                    Style="{StaticResource IconOnlyButton}"
                                    ToolTip="Logout"
                                    Visibility="{Binding SidebarExpandedVisibility}">
                                <Viewbox Width="18" Height="18">
                                    <Path Data="M 10,5 L 5,5 L 5,19 L 10,19 M 13,8 L 17,12 L 13,16 M 8,12 L 17,12"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent" />
                                </Viewbox>
                            </Button>
                        </Grid>
                        <Button Command="{Binding ToggleSidebarCommand}"
                                Style="{StaticResource IconOnlyButton}"
                                HorizontalAlignment="Center"
                                Margin="0,14,0,0"
                                ToolTip="Toggle menu">
                            <TextBlock Text="{Binding SidebarToggleIcon}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding SidebarExpandedVisibility}"
                                    Margin="0,12,0,0">
                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="#16A34A"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0" />
                            <TextBlock Text="Connected"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="28,18,24,0">
                <Grid>
                    <StackPanel Visibility="{Binding HomeVisibility}">
                        <Grid Margin="0,0,0,22"
                              Height="52"
                              ClipToBounds="False"
                              Panel.ZIndex="20"
                              Visibility="{Binding HomeDashboardVisibility}">
                            <TextBlock Text="Home"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Top" />

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top">
                                <Button Command="{Binding RefreshHomeCommand}"
                                        Style="{StaticResource IconGhostButton}"
                                        ToolTip="Refresh">
                                    <Viewbox Width="17" Height="17">
                                        <Path Data="{StaticResource IconRefreshGeometry}"
                                              Stroke="{StaticResource PrimaryBrush}"
                                              Style="{StaticResource LucidePath}" />
                                    </Viewbox>
                                </Button>
                                <Button Command="{Binding ToggleNotificationFlyoutCommand}"
                                        Style="{StaticResource IconSecondaryButton}"
                                        Margin="0,4,0,8"
                                        ToolTip="Notifications"
                                        MouseEnter="NotificationButton_OnMouseEnter"
                                        MouseLeave="NotificationButton_OnMouseLeave">
                                    <Grid>
                                        <Viewbox Width="18"
                                                 Height="18"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconBellGeometry}"
                                                  Stroke="{StaticResource PrimaryBrush}"
                                                  Style="{StaticResource LucidePath}" />
                                        </Viewbox>
                                        <Border Background="{StaticResource PrimaryBrush}"
                                                CornerRadius="8"
                                                MinWidth="16"
                                                Height="16"
                                                Padding="4,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,-8,-8,0">
                                            <TextBlock Text="{Binding UnreadNotificationBadgeText}"
                                                       Foreground="White"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <Border Visibility="Collapsed"
                                    Panel.ZIndex="100"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Width="340"
                                    Margin="0,52,0,0"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22" Opacity="0.12" ShadowDepth="8" />
                                </Border.Effect>
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Notifications" FontSize="17" FontWeight="SemiBold" />
                                        <Button Content="View all"
                                                Command="{Binding ViewAllNotificationsCommand}"
                                                Style="{StaticResource LinkButton}"
                                                HorizontalAlignment="Right" />
                                    </Grid>
                                    <Border Visibility="{Binding EmptyNotificationsVisibility}"
                                            Background="{StaticResource SurfaceMutedBrush}"
                                            CornerRadius="12"
                                            Padding="14">
                                        <TextBlock Text="No notifications."
                                                   Foreground="{StaticResource MutedInkBrush}" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding RecentHomeNotifications}"
                                                  Visibility="{Binding HasNotificationsVisibility}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.ViewAllNotificationsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Style="{StaticResource CardActionButton}">
                                                    <Border BorderBrush="{StaticResource BorderBrushSoft}"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="34" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="24" Height="24" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="12">
                                                                <Viewbox Width="13" Height="13">
                                                                    <Path Data="{StaticResource IconWarningGeometry}" Stroke="{StaticResource PrimaryBrush}" Style="{StaticResource LucidePath}" />
                                                                </Viewbox>
                                                            </Border>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Message}"
                                                                           Foreground="{StaticResource MutedInkBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding CreatedText}"
                                                                       Foreground="{StaticResource MutedInkBrush}"
                                                                       Margin="10,0,0,0" />
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Visibility="{Binding HomeEmptyVisibility}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="0,0,0,0"
                              MaxWidth="560">
                            <StackPanel>
                                <Grid Margin="0,0,0,22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <Border Width="30" Height="30" Background="#DCFCE7" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="15">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="#16A34A" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Sign in" Foreground="{StaticResource PrimaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Height="2" Background="{StaticResource PrimaryBrush}" Margin="8,15" />

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <Border Width="30" Height="30" Background="{Binding Step2Background}" BorderBrush="{Binding Step2Border}" BorderThickness="1" CornerRadius="15">
                                            <TextBlock Text="{Binding Step2DotText}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Step2Foreground}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Connect device" Foreground="{Binding Step2LabelForeground}" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="3" Height="2" Background="{Binding Step2ConnectorBrush}" Margin="8,15" />

                                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                        <Border Width="30" Height="30" Background="{Binding Step3Background}" BorderBrush="{Binding Step3Border}" BorderThickness="1" CornerRadius="15">
                                            <TextBlock Text="{Binding Step3DotText}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Step3Foreground}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Claim device" Foreground="{Binding Step3LabelForeground}" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="5" Height="2" Background="{Binding Step3ConnectorBrush}" Margin="8,15" />

                                    <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                                        <Border Width="30" Height="30" Background="{Binding Step4Background}" BorderBrush="{Binding Step4Border}" BorderThickness="1" CornerRadius="15">
                                            <TextBlock Text="{Binding Step4DotText}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Step4Foreground}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="You're all set" Foreground="{Binding Step4LabelForeground}" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Border Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="18"
                                        Padding="24"
                                        Margin="0,0,0,14">
                                    <StackPanel>
                                        <Border Width="64"
                                                Height="64"
                                                Background="{Binding OnboardingHeroIconBackground}"
                                                CornerRadius="20"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,16">
                                            <TextBlock Text="{Binding OnboardingHeroIcon}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{Binding OnboardingHeroIconForeground}"
                                                       FontSize="26"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding OnboardingTitle}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding OnboardingSubtitle}"
                                                   Foreground="{StaticResource MutedInkBrush}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   LineHeight="22"
                                                   Margin="0,6,0,18" />

                                        <StackPanel Visibility="{Binding OnboardingWaitingVisibility}">
                                            <Border Background="{StaticResource AppBackgroundBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="22" Height="22" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="11">
                                                        <TextBlock Text="1" Foreground="{StaticResource PrimaryBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="Open DeviceApp on this machine." Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                            <Border Background="{StaticResource AppBackgroundBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="22" Height="22" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="11">
                                                        <TextBlock Text="2" Foreground="{StaticResource PrimaryBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="Add a simulated device, then click Start." Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,4,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="{StaticResource PrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Waiting for a device to appear..." Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding OnboardingClaimVisibility}">
                                            <ItemsControl ItemsSource="{Binding AvailableDevices}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,10"
                                                              HorizontalAlignment="Stretch">
                                                            <Border Background="{StaticResource AppBackgroundBrush}"
                                                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="14"
                                                                    Padding="12"
                                                                    HorizontalAlignment="Stretch">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="44" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Width="34" Height="34" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="11">
                                                                        <TextBlock Text="{Binding KindIcon}" FontFamily="Segoe UI Emoji" Foreground="{StaticResource PrimaryBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1">
                                                                        <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold" />
                                                                        <TextBlock Text="{Binding Serial}" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                                                    </StackPanel>
                                                                    <Border Grid.Column="2" Background="#DCFCE7" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                                                        <TextBlock Text="Found" Foreground="#16A34A" FontSize="11" FontWeight="SemiBold" />
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                            <Button Command="{Binding DataContext.SelectAvailableDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="Transparent"
                                                                    BorderBrush="Transparent"
                                                                    Padding="0"
                                                                    Margin="0"
                                                                    HorizontalAlignment="Stretch"
                                                                    VerticalAlignment="Stretch"
                                                                    Opacity="0" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="Pairing code shown in DeviceApp" Style="{StaticResource SmallLabel}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding AvailablePairingCode, UpdateSourceTrigger=PropertyChanged}"
                                                         Tag="e.g. HD3KVGPA"
                                                         CharacterCasing="Upper"
                                                         Style="{StaticResource PlaceholderTextBox}"
                                                         Margin="0,4,8,8" />
                                                <Button Grid.Column="1"
                                                        Content="Claim"
                                                        Command="{Binding ClaimSelectedAvailableDeviceCommand}"
                                                        HorizontalAlignment="Stretch"
                                                        Height="44"
                                                        Margin="0,4,0,8" />
                                            </Grid>
                                            <TextBlock Text="{Binding AvailableClaimError}"
                                                       Visibility="{Binding AvailableClaimErrorVisibility}"
                                                       Foreground="#DC2626"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,4" />
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding OnboardingSuccessVisibility}">
                                            <Border Background="#DCFCE7" CornerRadius="36" Width="72" Height="72" HorizontalAlignment="Center" Margin="0,2,0,14">
                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="#16A34A" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="Taking you to the dashboard..."
                                                       Foreground="{StaticResource MutedInkBrush}"
                                                       TextAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,4" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <UniformGrid Columns="2">
                                    <Button Command="{Binding LaunchDeviceAppCommand}"
                                            Style="{StaticResource CardActionButton}"
                                            Padding="0"
                                            Margin="0,0,8,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch">
                                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="14">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="30" Height="30" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="9" Margin="0,0,10,0">
                                                    <TextBlock Text="&#xE768;" Style="{StaticResource IconGlyph}" FontSize="15" HorizontalAlignment="Center" />
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="Open DeviceApp" FontWeight="SemiBold" />
                                                    <TextBlock Text="Use Advanced shortcuts" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="30" Height="30" Background="#FEF3C7" CornerRadius="9" Margin="0,0,10,0">
                                                <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" Foreground="#D97706" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="Troubleshooting" FontWeight="SemiBold" />
                                                <TextBlock Text="Device not showing up?" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding HomeDeviceDetailVisibility}" Height="520">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Button Command="{Binding BackToHomeDashboardCommand}"
                                                Style="{StaticResource IconGhostButton}"
                                                Width="32"
                                                Height="32"
                                                Margin="0,0,8,0"
                                                ToolTip="Back to Home">
                                            <TextBlock Text="&#xE72B;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Button>
                                        <TextBlock Text="Home &gt; Devices"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="48" Height="48" Background="{Binding SelectedDeviceSurfaceBrush}" CornerRadius="12" Margin="0,0,14,0">
                                            <Viewbox Width="24" Height="24">
                                                <Path Data="{Binding SelectedDeviceIconData}" Stroke="{Binding SelectedDeviceIconBrush}" Style="{StaticResource LucidePath}" />
                                            </Viewbox>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedDeviceTypeLabel}"
                                                       Foreground="{Binding SelectedDeviceMutedBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <Grid Margin="0,4,0,0"
                                                  Visibility="{Binding HomeDeviceNameTextVisibility}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SelectedDeviceTitle}"
                                                           FontSize="24"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding SelectedDeviceContentBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="260"
                                                           Margin="0,0,8,0" />
                                                <Button Grid.Column="1"
                                                        Command="{Binding StartHomeDeviceRenameCommand}"
                                                        Style="{StaticResource IconGhostButton}"
                                                        ToolTip="Rename device">
                                                    <Viewbox Width="17" Height="17">
                                                        <Path Data="{StaticResource IconPencilGeometry}" Stroke="{StaticResource PrimaryBrush}" Style="{StaticResource LucidePath}" />
                                                    </Viewbox>
                                                </Button>
                                            </Grid>
                                            <Grid Margin="0,4,0,0"
                                                  Visibility="{Binding HomeDeviceRenameEditorVisibility}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding RenameDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="22"
                                                         FontWeight="Bold"
                                                         Height="38"
                                                         Padding="10,0"
                                                         VerticalContentAlignment="Center"
                                                         Margin="0,0,8,0" />
                                                <Button Grid.Column="1"
                                                        Command="{Binding RenameDeviceCommand}"
                                                        Style="{StaticResource IconGhostButton}"
                                                        ToolTip="Save name">
                                                    <Viewbox Width="17" Height="17">
                                                        <Path Data="{StaticResource IconPencilGeometry}" Stroke="{StaticResource PrimaryBrush}" Style="{StaticResource LucidePath}" />
                                                    </Viewbox>
                                                </Button>
                                                <Button Grid.Column="2"
                                                        Content="Cancel"
                                                        Command="{Binding CancelHomeDeviceRenameCommand}"
                                                        Style="{StaticResource LinkButton}"
                                                        VerticalAlignment="Center"
                                                        Margin="4,0,0,0" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <Ellipse Width="8" Height="8" Fill="{Binding SelectedDeviceStatusBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock Text="{Binding SelectedDeviceSubtitle}" Foreground="{Binding SelectedDeviceMutedBrush}" FontSize="13" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Command="{Binding RefreshHomeCommand}"
                                            Style="{StaticResource IconGhostButton}"
                                            ToolTip="Refresh">
                                        <Viewbox Width="17" Height="17">
                                            <Path Data="{StaticResource IconRefreshGeometry}" Stroke="{StaticResource PrimaryBrush}" Style="{StaticResource LucidePath}" />
                                        </Viewbox>
                                    </Button>
                                    <Button Command="{Binding UnclaimDeviceCommand}"
                                            Style="{StaticResource IconGhostButton}"
                                            ToolTip="Remove device">
                                        <Viewbox Width="17" Height="17">
                                            <Path Data="{StaticResource IconTrashGeometry}" Stroke="#DC2626" Style="{StaticResource LucidePath}" />
                                        </Viewbox>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="7*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="Controls" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                                        <ItemsControl ItemsSource="{Binding Actuators}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="156" Height="112" Background="{Binding CardBackground}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,12,12">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="28" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="24" Height="24" Background="{Binding IconBackground}" CornerRadius="12">
                                                                    <Viewbox Width="14" Height="14">
                                                                        <Path Data="{StaticResource IconZapGeometry}" Stroke="{Binding IconBrush}" Style="{StaticResource LucidePath}" />
                                                                    </Viewbox>
                                                                </Border>
                                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="{Binding ContentBrush}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            </Grid>
                                                            <TextBlock Grid.Row="1" Text="{Binding StateText}" Foreground="{Binding ContentBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                                                            <Button Grid.Row="2"
                                                                    Command="{Binding DataContext.SendActuatorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource ToggleSwitchButton}"
                                                                    IsEnabled="{Binding IsDeviceOnline}"
                                                                    HorizontalAlignment="Left"
                                                                    ToolTip="{Binding ButtonText}">
                                                                <Border Width="58" Height="30" Background="{Binding SwitchBackground}" CornerRadius="15" Padding="3">
                                                                    <Grid>
                                                                        <Border Width="24" Height="24" Background="White" CornerRadius="12" HorizontalAlignment="{Binding SwitchKnobAlignment}" />
                                                                    </Grid>
                                                                </Border>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Telemetry" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,12" />
                                        <ItemsControl ItemsSource="{Binding Sensors}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="156" Height="112" Background="{Binding CardBackground}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,12,12">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="28" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="24" Height="24" Background="{Binding IconBackground}" CornerRadius="12">
                                                                    <Viewbox Width="14" Height="14">
                                                                        <Path Data="{StaticResource IconSensorGeometry}" Stroke="{Binding IconBrush}" Style="{StaticResource LucidePath}" />
                                                                    </Viewbox>
                                                                </Border>
                                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="{Binding ContentBrush}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            </Grid>
                                                            <TextBlock Grid.Row="1" Text="{Binding ValueWithUnit}" Foreground="{Binding ContentBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Row="2" Text="{Binding RecordedAt}" Foreground="{Binding MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Height="1" Background="{StaticResource BorderBrushSoft}" Margin="0,12,0,18" />

                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Telemetry Log" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="(100 recent events)" Foreground="{StaticResource MutedInkBrush}" FontSize="13" Margin="8,1,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Visibility="{Binding EmptyHomeTelemetryLogVisibility}" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="16">
                                            <TextBlock Text="No state changes or sampled telemetry yet." Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Center" />
                                        </Border>
                                        <DataGrid ItemsSource="{Binding HomeDeviceTelemetryLog}"
                                                  Visibility="{Binding HasHomeTelemetryLogVisibility}"
                                                  MaxHeight="240"
                                                  AutoGenerateColumns="False"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  HorizontalGridLinesBrush="#F1F5F9"
                                                  BorderBrush="{StaticResource BorderBrushSoft}"
                                                  BorderThickness="1"
                                                  Background="{StaticResource SurfaceBrush}"
                                                  IsReadOnly="True"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Recorded" Binding="{Binding Recorded}" Width="120" />
                                                <DataGridTextColumn Header="Capability" Binding="{Binding CapabilityName}" Width="170" />
                                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </ScrollViewer>

                                <StackPanel Grid.Column="1">
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Device summary" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                            <Border Background="{Binding SelectedDeviceStatusBackground}" HorizontalAlignment="Left" Padding="8,4" CornerRadius="6" Margin="0,0,0,12">
                                                <TextBlock Text="{Binding SelectedDevice.Status}" Foreground="{Binding SelectedDeviceStatusBrush}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="Serial" Style="{StaticResource SmallLabel}" Margin="0" />
                                            <TextBlock Text="{Binding SelectedDevice.Serial}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,10" />
                                            <TextBlock Text="{Binding SelectedDeviceStatus}" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardBorder}" Margin="0">
                                        <StackPanel>
                                            <TextBlock Text="Advanced tools" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                            <Button Content="Manage device" Command="{Binding BackToHomeDashboardCommand}" Height="36" Margin="0,0,0,8" HorizontalAlignment="Stretch" />
                                            <Button Content="Open settings" Command="{Binding NavigateCommand}" CommandParameter="Settings" Height="36" Margin="0" HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Grid Visibility="{Binding HomeDashboardVisibility}" Height="520">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,2">
                                <Border Style="{StaticResource HomeStatCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="14">
                                            <Viewbox Width="16" Height="16">
                                                <Path Data="{StaticResource IconWifiGeometry}" Stroke="{StaticResource PrimaryBrush}" Style="{StaticResource LucidePath}" />
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Online" Style="{StaticResource SmallLabel}" Margin="0" FontSize="11" />
                                            <TextBlock Text="{Binding OnlineDeviceCount}" FontSize="19" FontWeight="Bold" LineHeight="21" />
                                            <TextBlock Text="devices" Foreground="{StaticResource MutedInkBrush}" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource HomeStatCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" Background="#F1F5F9" CornerRadius="14">
                                            <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconWifiGeometry}" Stroke="{StaticResource MutedInkBrush}" Style="{StaticResource LucidePath}" />
                                                <Line X1="2" Y1="15" X2="15" Y2="2" Stroke="{StaticResource MutedInkBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Offline" Style="{StaticResource SmallLabel}" Margin="0" FontSize="11" />
                                            <TextBlock Text="{Binding OfflineDeviceCount}" FontSize="19" FontWeight="Bold" LineHeight="21" />
                                            <TextBlock Text="devices" Foreground="{StaticResource MutedInkBrush}" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource HomeStatCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="14">
                                            <Viewbox Width="17" Height="17">
                                                <Path Data="{StaticResource IconSensorGeometry}" Stroke="{StaticResource PrimaryBrush}" Style="{StaticResource LucidePath}" />
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Sensors" Style="{StaticResource SmallLabel}" Margin="0" FontSize="11" />
                                            <TextBlock Text="{Binding HomeSensorCount}" FontSize="19" FontWeight="Bold" LineHeight="21" />
                                            <TextBlock Text="reporting" Foreground="{StaticResource MutedInkBrush}" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource HomeStatCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="14">
                                            <Viewbox Width="16" Height="16">
                                                <Path Data="{StaticResource IconZapGeometry}" Stroke="{StaticResource PrimaryBrush}" Style="{StaticResource LucidePath}" />
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Actuators" Style="{StaticResource SmallLabel}" Margin="0" FontSize="11" />
                                            <TextBlock Text="{Binding HomeActuatorCount}" FontSize="19" FontWeight="Bold" LineHeight="21" />
                                            <TextBlock Text="controllable" Foreground="{StaticResource MutedInkBrush}" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </UniformGrid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="7*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource CardBorder}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="Devices" FontSize="20" FontWeight="SemiBold" />
                                                <TextBlock Text="Control actuators and monitor sensors from one place."
                                                           Foreground="{StaticResource MutedInkBrush}" />
                                            </StackPanel>
                                            <Button Command="{Binding RefreshHomeCommand}"
                                                    Style="{StaticResource IconGhostButton}"
                                                    ToolTip="Refresh"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top">
                                                <Viewbox Width="17" Height="17">
                                                    <Path Data="{StaticResource IconRefreshGeometry}"
                                                          Stroke="{StaticResource PrimaryBrush}"
                                                          Style="{StaticResource LucidePath}" />
                                                </Viewbox>
                                            </Button>
                                        </Grid>

                                        <Grid Grid.Row="1" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                            <Button Content="All" Command="{Binding SetHomeDeviceFilterCommand}" CommandParameter="All" Style="{StaticResource PillButton}" Background="{Binding AllFilterBackground}" Foreground="{Binding AllFilterForeground}" />
                                            <Button Content="Online" Command="{Binding SetHomeDeviceFilterCommand}" CommandParameter="Online" Style="{StaticResource PillButton}" Background="{Binding OnlineFilterBackground}" Foreground="{Binding OnlineFilterForeground}" />
                                            <Button Content="Offline" Command="{Binding SetHomeDeviceFilterCommand}" CommandParameter="Offline" Style="{StaticResource PillButton}" Background="{Binding OfflineFilterBackground}" Foreground="{Binding OfflineFilterForeground}" />
                                            <Button Content="Actuators" Command="{Binding SetHomeDeviceFilterCommand}" CommandParameter="Actuators" Style="{StaticResource PillButton}" Background="{Binding ActuatorsFilterBackground}" Foreground="{Binding ActuatorsFilterForeground}" />
                                            <Button Content="Sensors" Command="{Binding SetHomeDeviceFilterCommand}" CommandParameter="Sensors" Style="{StaticResource PillButton}" Background="{Binding SensorsFilterBackground}" Foreground="{Binding SensorsFilterForeground}" />
                                            </StackPanel>
                                            <Button Content="View all devices >"
                                                    Command="{Binding SetHomeDeviceFilterCommand}"
                                                    CommandParameter="All"
                                                    Style="{StaticResource LinkButton}"
                                                    Visibility="{Binding HomeViewAllDevicesVisibility}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center" />
                                        </Grid>

                                        <ScrollViewer Grid.Row="2"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding FilteredHomeDeviceCards}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="172"
                                                            Height="132"
                                                            Tag="{Binding}"
                                                            Cursor="Hand"
                                                            MouseLeftButtonUp="HomeDeviceCard_OnMouseLeftButtonUp"
                                                            BorderBrush="{Binding CardBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="12"
                                                            Padding="12"
                                                            Margin="0,0,10,10"
                                                            Background="{Binding CardBackground}">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="*" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="32" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="28" Height="28" Background="{Binding IconBackground}" CornerRadius="14">
                                                                    <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <Path Data="{Binding KindIconData}"
                                                                              Stroke="{Binding IconBrush}"
                                                                              Style="{StaticResource LucidePath}" />
                                                                    </Viewbox>
                                                                </Border>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding CapabilityName}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding PrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding DeviceName}" Foreground="{Binding MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <TextBlock Grid.Row="1" Text="{Binding PrimaryValue}" Foreground="{Binding PrimaryBrush}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <Grid Grid.Row="2" Visibility="{Binding ActuatorActionVisibility}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding SwitchLabel}" Foreground="{Binding SwitchLabelBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <Button Command="{Binding DataContext.ToggleHomeActuatorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Grid.Column="1"
                                                                        Style="{StaticResource ToggleSwitchButton}"
                                                                        IsEnabled="{Binding IsOnline}">
                                                                    <Border Width="58" Height="30" Background="{Binding SwitchBackground}" CornerRadius="15" Padding="3">
                                                                        <Grid>
                                                                            <Border Width="24" Height="24" Background="White" CornerRadius="12" HorizontalAlignment="{Binding SwitchKnobAlignment}" />
                                                                        </Grid>
                                                                    </Border>
                                                                </Button>
                                                            </Grid>
                                                            <TextBlock Grid.Row="2" Text="{Binding SensorFooterText}" Foreground="{Binding MutedBrush}" FontSize="12" Visibility="{Binding SensorInfoVisibility}" TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <Border Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                                            <StackPanel>
                                                <TextBlock Text="Quick actions" Foreground="{StaticResource InkBrush}" FontSize="20" FontWeight="SemiBold" />
                                                <Button Command="{Binding OpenAddDeviceCommand}"
                                                        Style="{StaticResource CardActionButton}"
                                                        Margin="0,12,0,10">
                                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="48" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="36" Height="36" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="10">
                                                                <Viewbox Width="19" Height="19">
                                                                    <Path Data="{StaticResource IconHouseGeometry}" Stroke="{StaticResource PrimaryBrush}" Style="{StaticResource LucidePath}" />
                                                                </Viewbox>
                                                            </Border>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="Add a new device" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
                                                                <TextBlock Text="Pair via DeviceApp" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                                <Button Command="{Binding OpenCreateAutomationCommand}"
                                                        Style="{StaticResource CardActionButton}">
                                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="48" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="36" Height="36" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="10">
                                                                <Viewbox Width="19" Height="19">
                                                                    <Path Data="{StaticResource IconWorkflowGeometry}" Stroke="{StaticResource PrimaryBrush}" Style="{StaticResource LucidePath}" />
                                                                </Viewbox>
                                                            </Border>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="Create automation" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
                                                                <TextBlock Text="Trigger rules between devices" Foreground="{StaticResource MutedInkBrush}" FontSize="12" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <Grid>
                                            <TextBlock Text="Recent activities" FontSize="20" FontWeight="SemiBold" />
                                            <Button Content="View all"
                                                    Command="{Binding ViewAllNotificationsCommand}"
                                                    Style="{StaticResource LinkButton}"
                                                    HorizontalAlignment="Right" />
                                        </Grid>
                                        <Border Visibility="{Binding EmptyNotificationsVisibility}"
                                                Background="{StaticResource SurfaceMutedBrush}"
                                                CornerRadius="14"
                                                Padding="16"
                                                Margin="0,12,0,0">
                                            <TextBlock Text="No notifications yet."
                                                       Foreground="{StaticResource MutedInkBrush}" />
                                        </Border>
                                        <ScrollViewer MaxHeight="156"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      Visibility="{Binding HasNotificationsVisibility}"
                                                      Margin="0,12,0,0">
                                            <ItemsControl ItemsSource="{Binding RecentActivityNotifications}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                    <Button Command="{Binding DataContext.ViewAllNotificationsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Style="{StaticResource CardActionButton}"
                                                            Margin="0,0,0,12">
                                                        <Border Padding="0,2" CornerRadius="8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="34" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="24" Height="24" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="12">
                                                                    <Viewbox Width="13" Height="13">
                                                                        <Path Data="{StaticResource IconWarningGeometry}" Stroke="{StaticResource PrimaryBrush}" Style="{StaticResource LucidePath}" />
                                                                    </Viewbox>
                                                                </Border>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource MutedInkBrush}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" Text="{Binding CreatedText}" Foreground="{StaticResource MutedInkBrush}" />
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <Border Visibility="{Binding HomeNotificationFlyoutVisibility}"
                            Panel.ZIndex="1000"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="340"
                            Margin="0,52,0,0"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="16"
                            MouseEnter="NotificationFlyout_OnMouseEnter"
                            MouseLeave="NotificationFlyout_OnMouseLeave">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22" Opacity="0.12" ShadowDepth="8" />
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Notifications" FontSize="17" FontWeight="SemiBold" />
                                <Button Content="View all"
                                        Command="{Binding ViewAllNotificationsCommand}"
                                        Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Right" />
                            </Grid>
                            <Border Visibility="{Binding EmptyNotificationsVisibility}"
                                    Background="{StaticResource SurfaceMutedBrush}"
                                    CornerRadius="12"
                                    Padding="14">
                                <TextBlock Text="No notifications."
                                           Foreground="{StaticResource MutedInkBrush}" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding RecentHomeNotifications}"
                                          Visibility="{Binding HasNotificationsVisibility}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ViewAllNotificationsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource CardActionButton}">
                                            <Border BorderBrush="{StaticResource BorderBrushSoft}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="24" Height="24" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="12">
                                                        <Viewbox Width="13" Height="13">
                                                            <Path Data="{StaticResource IconWarningGeometry}" Stroke="{StaticResource PrimaryBrush}" Style="{StaticResource LucidePath}" />
                                                        </Viewbox>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Message}"
                                                                   Foreground="{StaticResource MutedInkBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding CreatedText}"
                                                               Foreground="{StaticResource MutedInkBrush}"
                                                               Margin="10,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="Collapsed">
                        <TextBlock Text="Devices" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="360" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardBorder}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Top" Content="Refresh devices" Command="{Binding RefreshDevicesCommand}" HorizontalAlignment="Left" />
                                    <ListBox ItemsSource="{Binding Devices}"
                                             SelectedItem="{Binding SelectedDevice}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Margin="0,12,0,0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrushSoft}"
                                                        BorderThickness="1"
                                                        CornerRadius="14"
                                                        Padding="14"
                                                        Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="160" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="38" Height="38" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="19">
                                                            <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}" HorizontalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding NameOrSerial}" FontWeight="SemiBold" FontSize="15" />
                                                            <TextBlock Text="{Binding Serial}" Foreground="{StaticResource MutedInkBrush}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                            <TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Right" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="Claim device" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="Pairing code" Style="{StaticResource SmallLabel}" />
                                        <TextBox Text="{Binding ClaimPairingCode, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Display name" Style="{StaticResource SmallLabel}" />
                                        <TextBox Text="{Binding ClaimDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Category" Style="{StaticResource SmallLabel}" />
                                        <TextBox Text="{Binding ClaimCategory, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Content="Claim" Command="{Binding ClaimDeviceCommand}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="Rename selected" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="Display name" Style="{StaticResource SmallLabel}" />
                                        <TextBox Text="{Binding RenameDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Category" Style="{StaticResource SmallLabel}" />
                                        <TextBox Text="{Binding RenameCategory, UpdateSourceTrigger=PropertyChanged}" />
                                        <WrapPanel>
                                            <Button Content="Save device" Command="{Binding RenameDeviceCommand}" HorizontalAlignment="Left" />
                                            <Button Content="Remove device"
                                                    Command="{Binding UnclaimDeviceCommand}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    HorizontalAlignment="Left" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding AutomationVisibility}">
                        <TextBlock Text="Automation" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="390" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardBorder}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Top" Content="Refresh rules" Command="{Binding RefreshAutomationRulesCommand}" HorizontalAlignment="Left" />
                                    <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding AutomationRuleCards}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                            <Border Background="#F8FAFC"
                                                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="12"
                                                                    Padding="14"
                                                                    Margin="0,0,0,10"
                                                                    Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding Gesture="LeftClick"
                                                                          Command="{Binding DataContext.SelectAutomationRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          CommandParameter="{Binding}" />
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="15"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <Border Grid.Column="1"
                                                                    Background="{Binding EnabledBackground}"
                                                                    CornerRadius="8"
                                                                    Padding="8,3"
                                                                    Margin="10,0,0,0">
                                                                <TextBlock Text="{Binding EnabledText}"
                                                                           Foreground="{Binding EnabledForeground}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold" />
                                                            </Border>
                                                            <TextBlock Grid.Row="1"
                                                                       Grid.ColumnSpan="2"
                                                                       Text="{Binding TriggerSummary}"
                                                                       Foreground="{StaticResource InkBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,9,0,0" />
                                                            <TextBlock Grid.Row="2"
                                                                       Grid.ColumnSpan="2"
                                                                       Text="{Binding ActionSummary}"
                                                                       Foreground="{StaticResource MutedInkBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,3,0,0" />
                                                            <TextBlock Grid.Row="3"
                                                                       Grid.ColumnSpan="2"
                                                                       Text="{Binding MetaSummary}"
                                                                       Foreground="{StaticResource MutedInkBrush}"
                                                                       FontSize="12"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,8,0,0" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Rule editor" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Name" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding AutomationName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AutomationTextBox}" />

                                    <Border Height="1" Background="{StaticResource BorderBrushSoft}" Margin="0,4,0,12" />
                                    <TextBlock Text="Trigger" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="Source" Style="{StaticResource SmallLabel}" />
                                    <ComboBox ItemsSource="{Binding AutomationSourceOptions}"
                                              SelectedValue="{Binding AutomationSourceSelectionKey, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="SelectionKey"
                                              DisplayMemberPath="DisplayName"
                                              Style="{StaticResource AutomationComboBox}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Operator" Style="{StaticResource SmallLabel}" />
                                            <ComboBox ItemsSource="{Binding AutomationOperatorOptions}"
                                                      SelectedValue="{Binding AutomationOperator, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding IsAutomationTriggerConfigured}"
                                                      Style="{StaticResource AutomationComboBox}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="Threshold value" Style="{StaticResource SmallLabel}" />
                                            <TextBox Text="{Binding AutomationThresholdValue, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding IsAutomationConditionEnabled}"
                                                     Style="{StaticResource AutomationTextBox}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource BorderBrushSoft}" Margin="0,4,0,12" />
                                    <TextBlock Text="Action" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="Target" Style="{StaticResource SmallLabel}" />
                                    <ComboBox ItemsSource="{Binding AutomationTargetOptions}"
                                              SelectedValue="{Binding AutomationTargetSelectionKey, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="SelectionKey"
                                              DisplayMemberPath="DisplayName"
                                              Style="{StaticResource AutomationComboBox}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Action" Style="{StaticResource SmallLabel}" />
                                            <ComboBox SelectedValue="{Binding AutomationCommandName, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Tag"
                                                      Style="{StaticResource AutomationComboBox}">
                                                <ComboBoxItem Content="Turn on" Tag="ON" />
                                                <ComboBoxItem Content="Turn off" Tag="OFF" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="Desired value" Style="{StaticResource SmallLabel}" />
                                            <ComboBox SelectedValue="{Binding AutomationDesiredValue, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Tag"
                                                      Style="{StaticResource AutomationComboBox}">
                                                <ComboBoxItem Content="On" Tag="true" />
                                                <ComboBoxItem Content="Off" Tag="false" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource BorderBrushSoft}" Margin="0,4,0,12" />
                                    <TextBlock Text="Schedule" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Cooldown seconds" Style="{StaticResource SmallLabel}" />
                                            <TextBox Text="{Binding AutomationCooldownSeconds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AutomationTextBox}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="Status" Style="{StaticResource SmallLabel}" />
                                            <CheckBox Content="Enabled" IsChecked="{Binding AutomationIsEnabled}" Margin="0,9,0,10" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Content="Run only during schedule" IsChecked="{Binding IsAutomationScheduleEnabled}" Margin="0,0,0,10" />
                                    <StackPanel Visibility="{Binding AutomationScheduleVisibility}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="From time" Style="{StaticResource SmallLabel}" />
                                                <ComboBox ItemsSource="{Binding AutomationTimeOptions}"
                                                          SelectedValue="{Binding AutomationActiveFromTime, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource AutomationComboBox}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="To time" Style="{StaticResource SmallLabel}" />
                                                <ComboBox ItemsSource="{Binding AutomationTimeOptions}"
                                                          SelectedValue="{Binding AutomationActiveToTime, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource AutomationComboBox}" />
                                            </StackPanel>
                                        </Grid>
                                        <WrapPanel Margin="0,0,0,10">
                                            <CheckBox Content="All" IsChecked="{Binding AutomationAllDays}" Margin="0,0,14,6" />
                                            <CheckBox Content="Mon" IsChecked="{Binding AutomationMonday}" Margin="0,0,10,6" />
                                            <CheckBox Content="Tue" IsChecked="{Binding AutomationTuesday}" Margin="0,0,10,6" />
                                            <CheckBox Content="Wed" IsChecked="{Binding AutomationWednesday}" Margin="0,0,10,6" />
                                            <CheckBox Content="Thu" IsChecked="{Binding AutomationThursday}" Margin="0,0,10,6" />
                                            <CheckBox Content="Fri" IsChecked="{Binding AutomationFriday}" Margin="0,0,10,6" />
                                            <CheckBox Content="Sat" IsChecked="{Binding AutomationSaturday}" Margin="0,0,10,6" />
                                            <CheckBox Content="Sun" IsChecked="{Binding AutomationSunday}" Margin="0,0,10,6" />
                                        </WrapPanel>
                                    </StackPanel>
                                    <WrapPanel>
                                        <Button Content="Save" Command="{Binding SaveAutomationRuleCommand}" />
                                        <Button Content="Delete" Command="{Binding DeleteAutomationRuleCommand}" Style="{StaticResource SecondaryButton}" />
                                        <Button Content="Executions" Command="{Binding LoadAutomationExecutionsCommand}" Style="{StaticResource SecondaryButton}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding NotificationsVisibility}">
                        <Grid Margin="0,0,16,10">
                            <TextBlock Text="Alerts" Style="{StaticResource SectionTitle}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Command="{Binding RefreshNotificationsCommand}"
                                        Style="{StaticResource IconGhostButton}"
                                        ToolTip="Refresh alerts">
                                    <Viewbox Width="17" Height="17">
                                        <Path Data="{StaticResource IconRefreshGeometry}"
                                              Stroke="{StaticResource PrimaryBrush}"
                                              Style="{StaticResource LucidePath}" />
                                    </Viewbox>
                                </Button>
                                <Button Content="Mark all as read"
                                        Command="{Binding MarkAllNotificationsReadCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Height="38"
                                        Padding="14,0"
                                        Margin="0,4,0,8" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Border Visibility="{Binding EmptyNotificationsVisibility}"
                                        Background="{StaticResource SurfaceMutedBrush}"
                                        CornerRadius="14"
                                        Padding="18">
                                    <TextBlock Text="No notifications yet. Important events will appear here when devices or automation need attention."
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedInkBrush}" />
                                </Border>
                                <ScrollViewer Visibility="{Binding HasNotificationsVisibility}"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Notifications}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrushSoft}"
                                                        BorderThickness="1"
                                                        CornerRadius="12"
                                                        Padding="14"
                                                        Margin="0,0,0,10"
                                                        Background="{StaticResource SurfaceBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="30"
                                                                Height="30"
                                                                Background="{Binding AlertIconBackground}"
                                                                CornerRadius="15"
                                                                VerticalAlignment="Top">
                                                            <Viewbox Width="15" Height="15">
                                                                <Path Data="{StaticResource IconWarningGeometry}"
                                                                      Stroke="{Binding AlertIconBrush}"
                                                                      Style="{StaticResource LucidePath}" />
                                                            </Viewbox>
                                                        </Border>
                                                        <StackPanel Grid.Column="1">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontSize="14"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource InkBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <Border Background="{Binding ReadStateBackground}"
                                                                        CornerRadius="9"
                                                                        Padding="8,2"
                                                                        Margin="10,0,0,0"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ReadStateText}"
                                                                               Foreground="{Binding ReadStateBrush}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Message}"
                                                                       Foreground="{StaticResource MutedInkBrush}"
                                                                       TextWrapping="Wrap"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,4,0,0" />
                                                            <TextBlock Text="{Binding Type}"
                                                                       Foreground="{StaticResource MutedInkBrush}"
                                                                       FontSize="11"
                                                                       Margin="0,8,0,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding CreatedFullText}"
                                                                   Foreground="{StaticResource MutedInkBrush}"
                                                                   FontSize="12"
                                                                   Margin="16,2,0,0"
                                                                   VerticalAlignment="Top" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SettingsVisibility}">
                        <TextBlock Text="Settings" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="DeviceApp" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LocalToolsHelp}"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,12" />
                                <WrapPanel>
                                    <Button Content="Open DeviceApp" Command="{Binding LaunchDeviceAppCommand}" Style="{StaticResource SecondaryButton}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Grid Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Manual command" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Capability key" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding CommandCapabilityKey, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Command name" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding CommandName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Desired value" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding CommandDesiredValue, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Content="Send command" Command="{Binding SendCommandCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Telemetry filter" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Capability key" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding HistoryCapabilityKey, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Content="Load selected device detail" Command="{Binding LoadDeviceDetailCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardBorder}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Latest values" FontSize="18" FontWeight="SemiBold" />
                                <DataGrid ItemsSource="{Binding LatestValues}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Capability" Binding="{Binding CapabilityKey}" Width="160" />
                                        <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="180" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding ValueType}" Width="80" />
                                        <DataGridTextColumn Header="Value" Binding="{Binding DisplayValue}" Width="120" />
                                        <DataGridTextColumn Header="Recorded" Binding="{Binding RecordedAtUtc}" Width="180" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Column="1"
                    Grid.Row="1"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1,1,0,0"
                    Padding="14"
                    Visibility="Collapsed">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource MutedInkBrush}" />
            </Border>
        </Grid>
    </Grid>
</Window>
