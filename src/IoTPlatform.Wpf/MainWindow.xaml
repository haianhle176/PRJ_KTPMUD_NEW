<Window x:Class="IoTPlatform.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniConnect IoT Platform" Height="760" Width="1180"
        MinHeight="680" MinWidth="1040">
    <DockPanel Margin="14">
        <Border DockPanel.Dock="Bottom" Background="#FFF3F4F6" Padding="10" CornerRadius="6">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Border>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="OmniConnect" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Functional MVP UI for auth, devices, telemetry, commands and automation" Foreground="#666" />
            </StackPanel>
            <Button Grid.Column="1" Content="Logout" Command="{Binding LogoutCommand}" />
        </Grid>

        <TabControl>
            <TabItem Header="Auth">
                <ScrollViewer>
                    <StackPanel Width="420" HorizontalAlignment="Left" Margin="4">
                        <TextBlock Text="API account" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="Email" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Password" />
                        <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Display name (register only)" />
                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Login" Command="{Binding LoginCommand}" />
                            <Button Content="Register" Command="{Binding RegisterCommand}" />
                        </StackPanel>
                        <TextBlock Text="Note: password field is plain TextBox for MVP speed. Replace with PasswordBox polish later." Foreground="#777" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Devices">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel>
                        <Button DockPanel.Dock="Top" Content="Refresh devices" Command="{Binding RefreshDevicesCommand}" HorizontalAlignment="Left" />
                        <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding NameOrSerial}" Width="180" />
                                <DataGridTextColumn Header="Serial" Binding="{Binding Serial}" Width="160" />
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                <DataGridTextColumn Header="Manifest" Binding="{Binding ManifestVersion}" Width="80" />
                                <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenAtUtc}" Width="170" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="Claim device" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Pairing code" />
                        <TextBox Text="{Binding ClaimPairingCode, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Display name" />
                        <TextBox Text="{Binding ClaimDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Category" />
                        <TextBox Text="{Binding ClaimCategory, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Claim" Command="{Binding ClaimDeviceCommand}" HorizontalAlignment="Left" />

                        <Separator Margin="0,10" />

                        <TextBlock Text="Rename/classify selected" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Display name" />
                        <TextBox Text="{Binding RenameDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Category" />
                        <TextBox Text="{Binding RenameCategory, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Save device" Command="{Binding RenameDeviceCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Telemetry">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Selected device telemetry" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBox Width="180" Text="{Binding HistoryCapabilityKey, UpdateSourceTrigger=PropertyChanged}" ToolTip="Optional capability key filter" />
                        <Button Content="Load telemetry" Command="{Binding LoadDeviceDetailCommand}" />
                    </StackPanel>

                    <GroupBox Grid.Row="1" Header="Latest values" Margin="0,8,0,4">
                        <DataGrid ItemsSource="{Binding LatestValues}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Capability" Binding="{Binding CapabilityKey}" Width="160" />
                                <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="180" />
                                <DataGridTextColumn Header="Type" Binding="{Binding ValueType}" Width="80" />
                                <DataGridTextColumn Header="Value" Binding="{Binding DisplayValue}" Width="120" />
                                <DataGridTextColumn Header="Recorded" Binding="{Binding RecordedAtUtc}" Width="180" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Header="History" Margin="0,4,0,0">
                        <DataGrid ItemsSource="{Binding TelemetryHistory}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Capability" Binding="{Binding CapabilityKey}" Width="160" />
                                <DataGridTextColumn Header="Value" Binding="{Binding DisplayValue}" Width="120" />
                                <DataGridTextColumn Header="Recorded" Binding="{Binding RecordedAtUtc}" Width="180" />
                                <DataGridTextColumn Header="Received" Binding="{Binding ReceivedAtUtc}" Width="180" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Commands">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Send actuator command" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Capability key" />
                        <TextBox Text="{Binding CommandCapabilityKey, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Command name" />
                        <TextBox Text="{Binding CommandName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Desired value" />
                        <TextBox Text="{Binding CommandDesiredValue, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Send command" Command="{Binding SendCommandCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                    <DataGrid Grid.Column="1" ItemsSource="{Binding Commands}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Command" Binding="{Binding CommandName}" Width="120" />
                            <DataGridTextColumn Header="Capability" Binding="{Binding CapabilityKey}" Width="160" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="100" />
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAtUtc}" Width="180" />
                            <DataGridTextColumn Header="Failure" Binding="{Binding FailureMessage}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Automation">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <Button DockPanel.Dock="Top" Content="Refresh rules" Command="{Binding RefreshAutomationRulesCommand}" HorizontalAlignment="Left" />
                        <DataGrid ItemsSource="{Binding AutomationRules}" SelectedItem="{Binding SelectedAutomationRule}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                                <DataGridTextColumn Header="If" Binding="{Binding SourceCapabilityKey}" Width="120" />
                                <DataGridTextColumn Header="Op" Binding="{Binding ComparisonOperator}" Width="60" />
                                <DataGridTextColumn Header="Then" Binding="{Binding TargetCapabilityKey}" Width="120" />
                                <DataGridTextColumn Header="Command" Binding="{Binding CommandName}" Width="100" />
                                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <StackPanel Grid.Column="1" Grid.RowSpan="2" Margin="14,0,0,0">
                        <TextBlock Text="Rule editor" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Name" />
                        <TextBox Text="{Binding AutomationName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Source device id" />
                        <TextBox Text="{Binding AutomationSourceDeviceId, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Source capability key" />
                        <TextBox Text="{Binding AutomationSourceCapabilityKey, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Operator" />
                        <TextBox Text="{Binding AutomationOperator, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Threshold value" />
                        <TextBox Text="{Binding AutomationThresholdValue, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Target device id" />
                        <TextBox Text="{Binding AutomationTargetDeviceId, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Target capability key" />
                        <TextBox Text="{Binding AutomationTargetCapabilityKey, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Command name" />
                        <TextBox Text="{Binding AutomationCommandName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Desired value" />
                        <TextBox Text="{Binding AutomationDesiredValue, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Cooldown seconds" />
                        <TextBox Text="{Binding AutomationCooldownSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Active from UTC (optional, HH:mm)" />
                        <TextBox Text="{Binding AutomationActiveFromTime, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Active to UTC (optional, HH:mm)" />
                        <TextBox Text="{Binding AutomationActiveToTime, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Active days bitmask (optional, Sun=1 Mon=2 ... Sat=64)" TextWrapping="Wrap" />
                        <TextBox Text="{Binding AutomationActiveDaysOfWeek, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Content="Enabled" IsChecked="{Binding AutomationIsEnabled}" Margin="0,4,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save rule" Command="{Binding SaveAutomationRuleCommand}" />
                            <Button Content="Delete rule" Command="{Binding DeleteAutomationRuleCommand}" />
                            <Button Content="Load executions" Command="{Binding LoadAutomationExecutionsCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <GroupBox Grid.Row="1" Header="Executions" Margin="0,8,0,0">
                        <DataGrid ItemsSource="{Binding AutomationExecutions}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="100" />
                                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="180" />
                                <DataGridTextColumn Header="Command" Binding="{Binding CommandId}" Width="220" />
                                <DataGridTextColumn Header="Evaluated" Binding="{Binding EvaluatedAtUtc}" Width="180" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Notifications">
                <DockPanel Margin="4">
                    <Button DockPanel.Dock="Top" Content="Refresh notifications" Command="{Binding RefreshNotificationsCommand}" HorizontalAlignment="Left" />
                    <DataGrid ItemsSource="{Binding Notifications}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150" />
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="180" />
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                            <DataGridCheckBoxColumn Header="Read" Binding="{Binding IsRead}" Width="70" />
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAtUtc}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
