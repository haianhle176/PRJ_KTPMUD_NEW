<Window x:Class="IoTPlatform.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniConnect IoT Platform"
        Height="{Binding AppWindowHeight}"
        Width="{Binding AppWindowWidth}"
        MinHeight="{Binding AppWindowMinHeight}"
        MinWidth="{Binding AppWindowMinWidth}"
        MaxHeight="{Binding AppWindowMaxHeight}"
        MaxWidth="{Binding AppWindowMaxWidth}"
        ResizeMode="{Binding AppResizeMode}"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Visibility="{Binding UnauthenticatedVisibility}">
            <Border Background="{StaticResource SurfaceBrush}"
                    Padding="24">
                <StackPanel Width="320" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="68"
                            Height="68"
                            Background="#2563EB"
                            CornerRadius="20"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15"
                                              Color="#2563EB"
                                              Opacity="0.25"
                                              ShadowDepth="5"
                                              Direction="270" />
                        </Border.Effect>
                        <Path Stroke="White"
                              StrokeThickness="4.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Fill"
                              Width="38"
                              Height="38"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M 12,2 L 3,7 L 3,17 L 12,22 L 21,17 L 21,7 Z M 12,9 A 3,3 0 0 0 9,12 L 9,17 L 15,17 L 15,12 A 3,3 0 0 0 12,9 Z" />
                    </Border>

                    <TextBlock Text="OmniConnect"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding AuthSubtitle}"
                               Foreground="{StaticResource MutedInkBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,4,0,20" />

                    <Border Height="44"
                            Margin="0,4,0,12"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="{Binding RegisterFieldVisibility}">
                        <Grid>
                            <TextBox x:Name="AuthUsernameTextBox"
                                     Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="16,0"
                                     Margin="0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     TextChanged="AuthUsernameTextBox_OnTextChanged" />
                            <TextBlock x:Name="UsernamePlaceholder"
                                       Text="*Username"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       Margin="16,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Opacity="0.72" />
                        </Grid>
                    </Border>

                    <Border Height="44"
                            Margin="0,4,0,12"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid>
                            <TextBox x:Name="AuthEmailTextBox"
                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="16,0"
                                     Margin="0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     TextChanged="AuthEmailTextBox_OnTextChanged" />
                            <TextBlock x:Name="EmailPlaceholder"
                                       Text="*Email"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       Margin="16,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Opacity="0.72" />
                        </Grid>
                    </Border>

                    <Border Height="44"
                            Margin="0,4,0,12"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid>
                            <PasswordBox x:Name="AuthPasswordBox"
                                         Padding="16,0,44,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         PasswordChanged="AuthPasswordBox_OnPasswordChanged" />
                            <TextBox x:Name="AuthPasswordTextBox"
                                     Padding="16,0,44,0"
                                     Margin="0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     TextChanged="AuthPasswordTextBox_OnTextChanged"
                                     Visibility="Collapsed" />
                            <TextBlock x:Name="PasswordPlaceholder"
                                       Text="*Password"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       Margin="16,0,44,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Opacity="0.72" />
                            <Button x:Name="PasswordVisibilityButton"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Margin="0,0,8,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Foreground="{StaticResource MutedInkBrush}"
                                    Click="PasswordVisibilityButton_OnClick">
                                <Grid Width="18" Height="18">
                                    <TextBlock x:Name="PasswordVisibilityIcon"
                                               Text="&#xE890;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="15"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Line x:Name="PasswordVisibilitySlash"
                                          X1="2"
                                          Y1="16"
                                          X2="16"
                                          Y2="2"
                                          Stroke="{StaticResource MutedInkBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>

                    <Button Content="{Binding AuthPrimaryButtonText}"
                            Command="{Binding SubmitAuthCommand}"
                            HorizontalAlignment="Stretch"
                            Height="44"
                            Margin="0,6,0,14" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding AuthSwitchPrefix}"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   VerticalAlignment="Center" />
                        <Button Content="{Binding AuthSwitchAction}"
                                Command="{Binding ToggleAuthModeCommand}"
                                Style="{StaticResource LinkButton}"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Visibility="{Binding AuthenticatedVisibility}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,0,1,0"
                    Padding="24">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                            <Border Width="44"
                                    Height="44"
                                    Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="14"
                                    Margin="0,0,12,0">
                                <TextBlock Text="&#xE790;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="White"
                                           FontSize="21"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="OmniConnect" FontSize="20" FontWeight="Bold" />
                                <TextBlock Text="SmartHome Platform" Foreground="{StaticResource MutedInkBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Home">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" Style="{StaticResource IconGlyph}" Margin="0,0,12,0" />
                                <TextBlock Text="Home" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Devices">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}" Margin="0,0,12,0" />
                                <TextBlock Text="Devices" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Automation">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyph}" Margin="0,0,12,0" />
                                <TextBlock Text="Automation" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Notifications">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" Style="{StaticResource IconGlyph}" Margin="0,0,12,0" />
                                <TextBlock Text="Notifications" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Separator Margin="0,18,0,18" />
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Advanced">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BE;" Style="{StaticResource IconGlyph}" Margin="0,0,12,0" />
                                <TextBlock Text="Advanced" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="34" Height="34" Background="{StaticResource PrimaryBrush}" CornerRadius="17" Margin="0,0,10,0">
                                <TextBlock Text="AU" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Admin User" FontWeight="SemiBold" />
                                <TextBlock Text="Cloud account" Foreground="{StaticResource MutedInkBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Cloud connection" Style="{StaticResource SmallLabel}" />
                        <TextBlock Text="Connected" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Button Content="Logout" Command="{Binding LogoutCommand}" Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="34,28,28,0">
                <Grid>
                    <StackPanel Visibility="{Binding HomeVisibility}">
                        <Grid Margin="0,0,0,22" Panel.ZIndex="20">
                            <StackPanel>
                                <TextBlock Text="Home" FontSize="30" FontWeight="Bold" />
                                <TextBlock Text="Overview of your dynamic IoT home"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top">
                                <Button Content="Refresh"
                                        Command="{Binding RefreshHomeCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Height="38" />
                                <Button Command="{Binding ToggleNotificationFlyoutCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Width="46"
                                        Height="38"
                                        Padding="0"
                                        Margin="0,4,0,8">
                                    <Grid>
                                        <TextBlock Text="&#xE7F4;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="17"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Border Background="{StaticResource PrimaryBrush}"
                                                CornerRadius="8"
                                                MinWidth="16"
                                                Height="16"
                                                Padding="4,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,-8,-8,0">
                                            <TextBlock Text="{Binding UnreadNotificationBadgeText}"
                                                       Foreground="White"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <Border Visibility="{Binding NotificationFlyoutVisibility}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Width="340"
                                    Margin="0,52,0,0"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22" Opacity="0.12" ShadowDepth="8" />
                                </Border.Effect>
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Notifications" FontSize="17" FontWeight="SemiBold" />
                                        <Button Content="View all"
                                                Command="{Binding ViewAllNotificationsCommand}"
                                                Style="{StaticResource LinkButton}"
                                                HorizontalAlignment="Right" />
                                    </Grid>
                                    <Border Visibility="{Binding EmptyNotificationsVisibility}"
                                            Background="{StaticResource SurfaceMutedBrush}"
                                            CornerRadius="12"
                                            Padding="14">
                                        <TextBlock Text="No notifications."
                                                   Foreground="{StaticResource MutedInkBrush}" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding RecentHomeNotifications}"
                                                  Visibility="{Binding HasNotificationsVisibility}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrushSoft}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="24" Height="24" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="12">
                                                            <TextBlock Text="{Binding SeverityIcon}"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       Foreground="{StaticResource PrimaryBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Message}"
                                                                       Foreground="{StaticResource MutedInkBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding CreatedText}"
                                                                   Foreground="{StaticResource MutedInkBrush}"
                                                                   Margin="10,0,0,0" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Visibility="{Binding HomeEmptyVisibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="0.8*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CardBorder}" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="Welcome to OmniConnect" FontSize="28" FontWeight="Bold" />
                                    <TextBlock Text="Connect your first dynamic IoT device."
                                               Foreground="{StaticResource MutedInkBrush}"
                                               FontSize="15"
                                               Margin="0,6,0,24" />

                                    <UniformGrid Columns="4" Margin="0,0,0,24">
                                        <StackPanel>
                                            <Border Width="42" Height="42" Background="{StaticResource PrimaryBrush}" CornerRadius="21">
                                                <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="Connect your device" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,10,0" />
                                        </StackPanel>
                                        <StackPanel>
                                            <Border Width="42" Height="42" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="21">
                                                <TextBlock Text="2" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="Enter pairing code" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,10,0" />
                                        </StackPanel>
                                        <StackPanel>
                                            <Border Width="42" Height="42" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="21">
                                                <TextBlock Text="3" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="Claim your device" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,10,0" />
                                        </StackPanel>
                                        <StackPanel>
                                            <Border Width="42" Height="42" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="21">
                                                <TextBlock Text="4" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="You're all set" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,10,0" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="18" Padding="18" Margin="0,0,0,18">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42" Background="{StaticResource SurfaceBrush}" CornerRadius="21">
                                                <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}" HorizontalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Start Worker and DeviceApp locally" FontWeight="SemiBold" />
                                                <TextBlock Text="When the device sends its manifest, it will appear as available here. Copy the pairing code from DeviceApp to claim it."
                                                           Foreground="{StaticResource MutedInkBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="{Binding LastHomeRefreshText}" Foreground="{StaticResource MutedInkBrush}" />
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="Available devices" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding AvailableDeviceMessage}"
                                                   Foreground="{StaticResource MutedInkBrush}"
                                                   Margin="0,4,0,12" />
                                        <Border Visibility="{Binding EmptyAvailableDevicesVisibility}"
                                                Background="{StaticResource SurfaceMutedBrush}"
                                                CornerRadius="14"
                                                Padding="16">
                                            <TextBlock Text="Waiting for DeviceApp..."
                                                       Foreground="{StaticResource MutedInkBrush}" />
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding AvailableDevices}"
                                                      Visibility="{Binding HasAvailableDevicesVisibility}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderBrushSoft}"
                                                            BorderThickness="1"
                                                            CornerRadius="16"
                                                            Padding="14"
                                                            Margin="0,0,0,10">
                                                        <StackPanel>
                                                            <Grid>
                                                                <TextBlock Text="{Binding Serial}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding StatusLabel}"
                                                                           Foreground="{StaticResource PrimaryBrush}"
                                                                           FontWeight="SemiBold"
                                                                           HorizontalAlignment="Right" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding CapabilitySummary}" Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,0" />
                                                            <TextBlock Text="{Binding ExpiresText}" Foreground="{StaticResource MutedInkBrush}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="Claim device" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="Pairing code" Style="{StaticResource SmallLabel}" Margin="0,12,0,4" />
                                        <TextBox Text="{Binding ClaimPairingCode, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Display name" Style="{StaticResource SmallLabel}" />
                                        <TextBox Text="{Binding ClaimDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Category" Style="{StaticResource SmallLabel}" />
                                        <TextBox Text="{Binding ClaimCategory, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Content="Claim device"
                                                Command="{Binding ClaimDeviceCommand}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <StackPanel Visibility="{Binding HomeDashboardVisibility}">
                            <UniformGrid Columns="4" Margin="0,0,0,10">
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <Border Width="46" Height="46" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="23">
                                            <TextBlock Text="&#xE701;" Style="{StaticResource IconGlyph}" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Online" Style="{StaticResource SmallLabel}" Margin="0,14,0,0" />
                                        <TextBlock Text="{Binding OnlineDeviceCount}" FontSize="32" FontWeight="Bold" />
                                        <TextBlock Text="devices" Foreground="{StaticResource MutedInkBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <Border Width="46" Height="46" Background="#F1F5F9" CornerRadius="23">
                                            <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Offline" Style="{StaticResource SmallLabel}" Margin="0,14,0,0" />
                                        <TextBlock Text="{Binding OfflineDeviceCount}" FontSize="32" FontWeight="Bold" />
                                        <TextBlock Text="devices" Foreground="{StaticResource MutedInkBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <Border Width="46" Height="46" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="23">
                                            <TextBlock Text="&#xE95B;" Style="{StaticResource IconGlyph}" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Sensors" Style="{StaticResource SmallLabel}" Margin="0,14,0,0" />
                                        <TextBlock Text="{Binding SelectedSensorCount}" FontSize="32" FontWeight="Bold" />
                                        <TextBlock Text="on selected device" Foreground="{StaticResource MutedInkBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <Border Width="46" Height="46" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="23">
                                            <TextBlock Text="&#xE945;" Style="{StaticResource IconGlyph}" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Actuators" Style="{StaticResource SmallLabel}" Margin="0,14,0,0" />
                                        <TextBlock Text="{Binding SelectedActuatorCount}" FontSize="32" FontWeight="Bold" />
                                        <TextBlock Text="controllable" Foreground="{StaticResource MutedInkBrush}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="1.55*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="Devices" FontSize="20" FontWeight="SemiBold" />
                                                <TextBlock Text="Select one to view its live capabilities."
                                                           Foreground="{StaticResource MutedInkBrush}" />
                                            </StackPanel>
                                            <Button Content="Refresh"
                                                    Command="{Binding RefreshHomeCommand}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top" />
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Devices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelectDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            HorizontalAlignment="Stretch"
                                                            Padding="0"
                                                            Margin="0,0,0,10">
                                                        <Border Padding="14" CornerRadius="16" Background="White">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="46" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="36" Height="36" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="18">
                                                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}" HorizontalAlignment="Center" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding NameOrSerial}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedInkBrush}" />
                                                                </StackPanel>
                                                                <Border Grid.Column="2"
                                                                        Background="{StaticResource SurfaceMutedBrush}"
                                                                        CornerRadius="10"
                                                                        Padding="10,4"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Status}"
                                                                               Foreground="{StaticResource PrimaryBrush}"
                                                                               FontWeight="SemiBold" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding SelectedDeviceName}" FontSize="24" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SelectedDeviceStatus}" Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,18" />
                                            </StackPanel>
                                            <Button Content="Remove device"
                                                    Command="{Binding UnclaimDeviceCommand}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Visibility="{Binding HasSelectedDeviceVisibility}" />
                                        </Grid>

                                        <Border Visibility="{Binding NoSelectedDeviceVisibility}"
                                                Background="{StaticResource SurfaceMutedBrush}"
                                                CornerRadius="14"
                                                Padding="20">
                                            <TextBlock Text="Choose a device on the left. OmniConnect will build controls from the capabilities this device announces."
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource MutedInkBrush}" />
                                        </Border>

                                        <StackPanel Visibility="{Binding HasSelectedDeviceVisibility}">
                                            <TextBlock Text="Sensors" FontSize="17" FontWeight="SemiBold" />
                                            <ItemsControl ItemsSource="{Binding Sensors}" Margin="0,8,0,18">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="210"
                                                                Background="{StaticResource SurfaceMutedBrush}"
                                                                BorderBrush="{StaticResource BorderBrushSoft}"
                                                                BorderThickness="1"
                                                                CornerRadius="16"
                                                                Padding="16"
                                                                Margin="0,0,12,12">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding ValueWithUnit}" FontSize="24" FontWeight="Bold" Margin="0,8,0,2" />
                                                                <TextBlock Text="{Binding RecordedAt}" Foreground="{StaticResource MutedInkBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="Actuators" FontSize="17" FontWeight="SemiBold" />
                                            <ItemsControl ItemsSource="{Binding Actuators}" Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="240"
                                                                BorderBrush="{StaticResource BorderBrushSoft}"
                                                                BorderThickness="1"
                                                                CornerRadius="16"
                                                                Padding="16"
                                                                Margin="0,0,12,12">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding StateText}" Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,12" />
                                                                <Button Content="{Binding ButtonText}"
                                                                        Command="{Binding DataContext.SendActuatorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        HorizontalAlignment="Stretch" />
                                                                <TextBlock Text="{Binding LastStatus}" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="Latest sensor readings" FontSize="20" FontWeight="SemiBold" />
                                        <ItemsControl ItemsSource="{Binding LatestValues}" Margin="0,12,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding CapabilityKey}" Foreground="{StaticResource MutedInkBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding DisplayValue}"
                                                                   FontSize="18"
                                                                   FontWeight="SemiBold" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Recent activity" FontSize="20" FontWeight="SemiBold" />
                                            <Button Content="View all"
                                                    Command="{Binding ViewAllNotificationsCommand}"
                                                    Style="{StaticResource LinkButton}"
                                                    HorizontalAlignment="Right" />
                                        </Grid>
                                        <Border Visibility="{Binding EmptyNotificationsVisibility}"
                                                Background="{StaticResource SurfaceMutedBrush}"
                                                CornerRadius="14"
                                                Padding="16"
                                                Margin="0,12,0,0">
                                            <TextBlock Text="No notifications yet."
                                                       Foreground="{StaticResource MutedInkBrush}" />
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding RecentHomeNotifications}"
                                                      Visibility="{Binding HasNotificationsVisibility}"
                                                      Margin="0,12,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="24" Height="24" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="12">
                                                            <TextBlock Text="{Binding SeverityIcon}"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       Foreground="{StaticResource PrimaryBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource MutedInkBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding CreatedText}" Foreground="{StaticResource MutedInkBrush}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding DevicesVisibility}">
                        <TextBlock Text="Devices" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="360" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardBorder}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Top" Content="Refresh devices" Command="{Binding RefreshDevicesCommand}" HorizontalAlignment="Left" />
                                    <ListBox ItemsSource="{Binding Devices}"
                                             SelectedItem="{Binding SelectedDevice}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Margin="0,12,0,0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrushSoft}"
                                                        BorderThickness="1"
                                                        CornerRadius="14"
                                                        Padding="14"
                                                        Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="160" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="38" Height="38" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="19">
                                                            <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}" HorizontalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding NameOrSerial}" FontWeight="SemiBold" FontSize="15" />
                                                            <TextBlock Text="{Binding Serial}" Foreground="{StaticResource MutedInkBrush}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                            <TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Right" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="Claim device" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="Pairing code" Style="{StaticResource SmallLabel}" />
                                        <TextBox Text="{Binding ClaimPairingCode, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Display name" Style="{StaticResource SmallLabel}" />
                                        <TextBox Text="{Binding ClaimDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Category" Style="{StaticResource SmallLabel}" />
                                        <TextBox Text="{Binding ClaimCategory, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Content="Claim" Command="{Binding ClaimDeviceCommand}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="Rename selected" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="Display name" Style="{StaticResource SmallLabel}" />
                                        <TextBox Text="{Binding RenameDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Category" Style="{StaticResource SmallLabel}" />
                                        <TextBox Text="{Binding RenameCategory, UpdateSourceTrigger=PropertyChanged}" />
                                        <WrapPanel>
                                            <Button Content="Save device" Command="{Binding RenameDeviceCommand}" HorizontalAlignment="Left" />
                                            <Button Content="Remove device"
                                                    Command="{Binding UnclaimDeviceCommand}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    HorizontalAlignment="Left" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding AutomationVisibility}">
                        <TextBlock Text="Automation" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="390" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardBorder}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Top" Content="Refresh rules" Command="{Binding RefreshAutomationRulesCommand}" HorizontalAlignment="Left" />
                                    <DataGrid ItemsSource="{Binding AutomationRules}" SelectedItem="{Binding SelectedAutomationRule}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                                            <DataGridTextColumn Header="If" Binding="{Binding SourceCapabilityKey}" Width="120" />
                                            <DataGridTextColumn Header="Op" Binding="{Binding ComparisonOperator}" Width="60" />
                                            <DataGridTextColumn Header="Then" Binding="{Binding TargetCapabilityKey}" Width="120" />
                                            <DataGridTextColumn Header="Command" Binding="{Binding CommandName}" Width="100" />
                                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="80" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Rule editor" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Name" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding AutomationName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Source device id" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding AutomationSourceDeviceId, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Source capability key" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding AutomationSourceCapabilityKey, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Operator" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding AutomationOperator, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Threshold value" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding AutomationThresholdValue, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Target device id" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding AutomationTargetDeviceId, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Target capability key" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding AutomationTargetCapabilityKey, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Command name" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding AutomationCommandName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Desired value" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding AutomationDesiredValue, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Cooldown seconds" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding AutomationCooldownSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="Enabled" IsChecked="{Binding AutomationIsEnabled}" Margin="0,0,0,10" />
                                    <WrapPanel>
                                        <Button Content="Save" Command="{Binding SaveAutomationRuleCommand}" />
                                        <Button Content="Delete" Command="{Binding DeleteAutomationRuleCommand}" Style="{StaticResource SecondaryButton}" />
                                        <Button Content="Executions" Command="{Binding LoadAutomationExecutionsCommand}" Style="{StaticResource SecondaryButton}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding NotificationsVisibility}">
                        <TextBlock Text="Notifications" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource CardBorder}">
                            <DockPanel>
                                <Button DockPanel.Dock="Top" Content="Refresh notifications" Command="{Binding RefreshNotificationsCommand}" HorizontalAlignment="Left" />
                                <Border Visibility="{Binding EmptyNotificationsVisibility}" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="14" Padding="18">
                                    <TextBlock Text="No notifications yet. Important events will appear here when devices or automation need attention."
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedInkBrush}" />
                                </Border>
                                <DataGrid ItemsSource="{Binding Notifications}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150" />
                                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="180" />
                                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                                        <DataGridCheckBoxColumn Header="Read" Binding="{Binding IsRead}" Width="70" />
                                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedAtUtc}" Width="180" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding AdvancedVisibility}">
                        <TextBlock Text="Advanced" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Local developer tools" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding WorkerLaunchHelp}"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,12" />
                                <WrapPanel>
                                    <Button Content="Open Worker" Command="{Binding LaunchWorkerCommand}" />
                                    <Button Content="Open DeviceApp" Command="{Binding LaunchDeviceAppCommand}" Style="{StaticResource SecondaryButton}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Manual command" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Capability key" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding CommandCapabilityKey, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Command name" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding CommandName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Desired value" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding CommandDesiredValue, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Content="Send command" Command="{Binding SendCommandCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Telemetry filter" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Capability key" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding HistoryCapabilityKey, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Content="Load selected device detail" Command="{Binding LoadDeviceDetailCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Latest values" FontSize="18" FontWeight="SemiBold" />
                                <DataGrid ItemsSource="{Binding LatestValues}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Capability" Binding="{Binding CapabilityKey}" Width="160" />
                                        <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="180" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding ValueType}" Width="80" />
                                        <DataGridTextColumn Header="Value" Binding="{Binding DisplayValue}" Width="120" />
                                        <DataGridTextColumn Header="Recorded" Binding="{Binding RecordedAtUtc}" Width="180" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Column="1"
                    Grid.Row="1"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1,1,0,0"
                    Padding="14">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource MutedInkBrush}" />
            </Border>
        </Grid>
    </Grid>
</Window>
