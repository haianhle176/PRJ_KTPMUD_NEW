<Window x:Class="IoTPlatform.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniConnect IoT Platform"
        Height="820"
        Width="1280"
        MinHeight="720"
        MinWidth="1080">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Visibility="{Binding UnauthenticatedVisibility}" Margin="44">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="26"
                    Padding="42">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="460" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Margin="10,0,70,0">
                        <Border Width="58"
                                Height="58"
                                Background="{StaticResource PrimaryBrush}"
                                CornerRadius="18"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,26">
                            <TextBlock Text="OC"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Welcome to OmniConnect"
                                   FontSize="38"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Connect your first dynamic IoT device, claim it with a pairing code, then let the app build controls from its capabilities."
                                   Foreground="{StaticResource MutedInkBrush}"
                                   FontSize="16"
                                   LineHeight="25"
                                   TextWrapping="Wrap"
                                   Margin="0,14,0,30" />

                        <Border Background="{StaticResource SurfaceMutedBrush}"
                                CornerRadius="18"
                                Padding="18"
                                MaxWidth="560"
                                HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="Demo flow" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="1. Start Worker locally  2. Start DeviceApp locally  3. Copy pairing code  4. Claim device in the app"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{StaticResource SurfaceMutedBrush}"
                            CornerRadius="24"
                            Padding="30"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="API account" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Email" Style="{StaticResource SmallLabel}" />
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Password" Style="{StaticResource SmallLabel}" />
                            <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Display name for register" Style="{StaticResource SmallLabel}" />
                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                                <Button Content="Login" Command="{Binding LoginCommand}" />
                                <Button Content="Register" Command="{Binding RegisterCommand}" Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                            <TextBlock Text="This app connects to the Azure API. Worker and DeviceApp are only needed on the developer machine."
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12"
                    Margin="0,16,0,0">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource MutedInkBrush}" />
            </Border>
        </Grid>

        <Grid Visibility="{Binding AuthenticatedVisibility}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,0,1,0"
                    Padding="24">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                            <Border Width="44"
                                    Height="44"
                                    Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="14"
                                    Margin="0,0,12,0">
                                <TextBlock Text="OC"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="OmniConnect" FontSize="20" FontWeight="Bold" />
                                <TextBlock Text="SmartHome Platform" Foreground="{StaticResource MutedInkBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Button Content="Home" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Home" />
                        <Button Content="Devices" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Devices" />
                        <Button Content="Automation" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Automation" />
                        <Button Content="Notifications" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Notifications" />

                        <Separator Margin="0,18,0,18" />
                        <Button Content="Advanced" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Advanced" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="34" Height="34" Background="{StaticResource PrimaryBrush}" CornerRadius="17" Margin="0,0,10,0">
                                <TextBlock Text="AU" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Admin User" FontWeight="SemiBold" />
                                <TextBlock Text="Cloud account" Foreground="{StaticResource MutedInkBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Azure API" Style="{StaticResource SmallLabel}" />
                        <TextBlock Text="Connected to cloud" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Button Content="Logout" Command="{Binding LogoutCommand}" Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="34,28,28,0">
                <Grid>
                    <StackPanel Visibility="{Binding HomeVisibility}">
                        <Grid Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="Home" FontSize="28" FontWeight="Bold" />
                                <TextBlock Text="Overview of your dynamic IoT home"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                            <Button Content="Refresh"
                                    Command="{Binding RefreshDevicesCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top" />
                        </Grid>

                        <UniformGrid Columns="4" Margin="0,0,0,4">
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Online" Style="{StaticResource SmallLabel}" />
                                    <TextBlock Text="{Binding OnlineDeviceCount}" FontSize="32" FontWeight="Bold" />
                                    <TextBlock Text="devices" Foreground="{StaticResource MutedInkBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Offline" Style="{StaticResource SmallLabel}" />
                                    <TextBlock Text="{Binding OfflineDeviceCount}" FontSize="32" FontWeight="Bold" />
                                    <TextBlock Text="devices" Foreground="{StaticResource MutedInkBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Unread alerts" Style="{StaticResource SmallLabel}" />
                                    <TextBlock Text="{Binding UnreadNotificationCount}" FontSize="32" FontWeight="Bold" />
                                    <TextBlock Text="notifications" Foreground="{StaticResource MutedInkBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Automation" Style="{StaticResource SmallLabel}" />
                                    <TextBlock Text="{Binding EnabledAutomationCount}" FontSize="32" FontWeight="Bold" />
                                    <TextBlock Text="enabled rules" Foreground="{StaticResource MutedInkBrush}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="1.75*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CardBorder}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top">
                                        <TextBlock Text="Devices" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="Select one to view its live capabilities."
                                                   Foreground="{StaticResource MutedInkBrush}"
                                                   Margin="0,2,0,14" />
                                        <Button Content="Refresh" Command="{Binding RefreshDevicesCommand}" Style="{StaticResource SecondaryButton}" />
                                    </StackPanel>

                                    <Border Visibility="{Binding EmptyDevicesVisibility}"
                                            Background="{StaticResource SurfaceMutedBrush}"
                                            CornerRadius="14"
                                            Padding="18">
                                        <TextBlock Text="No claimed devices yet. Start DeviceApp, copy its pairing code, then claim it in Devices."
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedInkBrush}" />
                                    </Border>

                                    <ListBox ItemsSource="{Binding Devices}"
                                             SelectedItem="{Binding SelectedDevice}"
                                             Visibility="{Binding HasDevicesVisibility}"
                                             BorderThickness="0"
                                             Background="Transparent">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding NameOrSerial}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedInkBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedDeviceName}" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedDeviceStatus}" Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,18" />

                                    <Border Visibility="{Binding NoSelectedDeviceVisibility}"
                                            Background="{StaticResource SurfaceMutedBrush}"
                                            CornerRadius="14"
                                            Padding="20">
                                        <TextBlock Text="Choose a device on the left. OmniConnect will build this page from the device capabilities, not from a hard-coded template."
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedInkBrush}" />
                                    </Border>

                                    <StackPanel Visibility="{Binding HasSelectedDeviceVisibility}">
                                        <TextBlock Text="Sensors" FontSize="16" FontWeight="SemiBold" />
                                        <ItemsControl ItemsSource="{Binding Sensors}" Margin="0,8,0,16">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="210" Style="{StaticResource CardBorder}" Background="{StaticResource SurfaceMutedBrush}" Margin="0,0,12,12">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding ValueWithUnit}" FontSize="24" FontWeight="Bold" Margin="0,8,0,2" />
                                                            <TextBlock Text="{Binding RecordedAt}" Foreground="{StaticResource MutedInkBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Actuators" FontSize="16" FontWeight="SemiBold" />
                                        <ItemsControl ItemsSource="{Binding Actuators}" Margin="0,8,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="260" Style="{StaticResource CardBorder}" Margin="0,0,12,12">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding StateText}" Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,12" />
                                                            <Button Content="{Binding ButtonText}"
                                                                    Command="{Binding DataContext.SendActuatorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" />
                                                            <TextBlock Text="{Binding LastStatus}" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding DevicesVisibility}">
                        <TextBlock Text="Devices" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="360" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardBorder}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Top" Content="Refresh devices" Command="{Binding RefreshDevicesCommand}" HorizontalAlignment="Left" />
                                    <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding NameOrSerial}" Width="180" />
                                            <DataGridTextColumn Header="Serial" Binding="{Binding Serial}" Width="160" />
                                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                            <DataGridTextColumn Header="Manifest" Binding="{Binding ManifestVersion}" Width="80" />
                                            <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenAtUtc}" Width="170" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="Claim device" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="Pairing code" Style="{StaticResource SmallLabel}" />
                                        <TextBox Text="{Binding ClaimPairingCode, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Display name" Style="{StaticResource SmallLabel}" />
                                        <TextBox Text="{Binding ClaimDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Category" Style="{StaticResource SmallLabel}" />
                                        <TextBox Text="{Binding ClaimCategory, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Content="Claim" Command="{Binding ClaimDeviceCommand}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="Rename selected" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="Display name" Style="{StaticResource SmallLabel}" />
                                        <TextBox Text="{Binding RenameDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Category" Style="{StaticResource SmallLabel}" />
                                        <TextBox Text="{Binding RenameCategory, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Content="Save device" Command="{Binding RenameDeviceCommand}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding AutomationVisibility}">
                        <TextBlock Text="Automation" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="390" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardBorder}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Top" Content="Refresh rules" Command="{Binding RefreshAutomationRulesCommand}" HorizontalAlignment="Left" />
                                    <DataGrid ItemsSource="{Binding AutomationRules}" SelectedItem="{Binding SelectedAutomationRule}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                                            <DataGridTextColumn Header="If" Binding="{Binding SourceCapabilityKey}" Width="120" />
                                            <DataGridTextColumn Header="Op" Binding="{Binding ComparisonOperator}" Width="60" />
                                            <DataGridTextColumn Header="Then" Binding="{Binding TargetCapabilityKey}" Width="120" />
                                            <DataGridTextColumn Header="Command" Binding="{Binding CommandName}" Width="100" />
                                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="80" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Rule editor" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Name" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding AutomationName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Source device id" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding AutomationSourceDeviceId, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Source capability key" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding AutomationSourceCapabilityKey, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Operator" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding AutomationOperator, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Threshold value" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding AutomationThresholdValue, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Target device id" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding AutomationTargetDeviceId, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Target capability key" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding AutomationTargetCapabilityKey, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Command name" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding AutomationCommandName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Desired value" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding AutomationDesiredValue, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Cooldown seconds" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding AutomationCooldownSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="Enabled" IsChecked="{Binding AutomationIsEnabled}" Margin="0,0,0,10" />
                                    <WrapPanel>
                                        <Button Content="Save" Command="{Binding SaveAutomationRuleCommand}" />
                                        <Button Content="Delete" Command="{Binding DeleteAutomationRuleCommand}" Style="{StaticResource SecondaryButton}" />
                                        <Button Content="Executions" Command="{Binding LoadAutomationExecutionsCommand}" Style="{StaticResource SecondaryButton}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding NotificationsVisibility}">
                        <TextBlock Text="Notifications" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource CardBorder}">
                            <DockPanel>
                                <Button DockPanel.Dock="Top" Content="Refresh notifications" Command="{Binding RefreshNotificationsCommand}" HorizontalAlignment="Left" />
                                <Border Visibility="{Binding EmptyNotificationsVisibility}" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="14" Padding="18">
                                    <TextBlock Text="No notifications yet. Important events will appear here when devices or automation need attention."
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedInkBrush}" />
                                </Border>
                                <DataGrid ItemsSource="{Binding Notifications}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150" />
                                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="180" />
                                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                                        <DataGridCheckBoxColumn Header="Read" Binding="{Binding IsRead}" Width="70" />
                                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedAtUtc}" Width="180" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding AdvancedVisibility}">
                        <TextBlock Text="Advanced" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Local developer tools" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding WorkerLaunchHelp}"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,12" />
                                <WrapPanel>
                                    <Button Content="Open Worker" Command="{Binding LaunchWorkerCommand}" />
                                    <Button Content="Open DeviceApp" Command="{Binding LaunchDeviceAppCommand}" Style="{StaticResource SecondaryButton}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Manual command" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Capability key" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding CommandCapabilityKey, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Command name" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding CommandName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Desired value" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding CommandDesiredValue, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Content="Send command" Command="{Binding SendCommandCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Telemetry filter" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Capability key" Style="{StaticResource SmallLabel}" />
                                    <TextBox Text="{Binding HistoryCapabilityKey, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Content="Load selected device detail" Command="{Binding LoadDeviceDetailCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Latest values" FontSize="18" FontWeight="SemiBold" />
                                <DataGrid ItemsSource="{Binding LatestValues}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Capability" Binding="{Binding CapabilityKey}" Width="160" />
                                        <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="180" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding ValueType}" Width="80" />
                                        <DataGridTextColumn Header="Value" Binding="{Binding DisplayValue}" Width="120" />
                                        <DataGridTextColumn Header="Recorded" Binding="{Binding RecordedAtUtc}" Width="180" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Column="1"
                    Grid.Row="1"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1,1,0,0"
                    Padding="14">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource MutedInkBrush}" />
            </Border>
        </Grid>
    </Grid>
</Window>
