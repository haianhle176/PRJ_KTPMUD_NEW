<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\OmniConnectLogo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.0" />
    <ProjectReference Include="..\IoTPlatform.Application\IoTPlatform.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\OmniConnectLogo.png" />
    <Resource Include="Assets\OmniConnectLogo.ico" />
    <None Include="Assets\omniconnect.drawio.svg" />
  </ItemGroup>

</Project>
