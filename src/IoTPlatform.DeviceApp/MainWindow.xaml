<Window x:Class="IoTPlatform.DeviceApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniConnect Device Simulator"
        Width="1120"
        Height="760"
        MinWidth="960"
        MinHeight="640"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/DeviceAppLogo.ico"
        Closing="Window_OnClosing">
    <Grid>
        <Grid Visibility="{Binding AuthVisibility}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#EFF6FF" Offset="0" />
                    <GradientStop Color="#F8FAFC" Offset="0.55" />
                    <GradientStop Color="#EEF2FF" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Border Width="420"
                    Padding="38"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="10" Opacity="0.12" Color="#334155" />
                </Border.Effect>
                <StackPanel>
                    <Border Width="76" Height="76" Background="#EFF6FF" CornerRadius="22" HorizontalAlignment="Left" Margin="0,0,0,22">
                        <Image Source="Assets/DeviceAppLogo.png" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="Đăng nhập" FontSize="30" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="Dùng cùng tài khoản OmniConnect để mô phỏng các thiết bị trong tài khoản của bạn."
                               Foreground="{StaticResource MutedInkBrush}"
                               FontSize="14"
                               LineHeight="21"
                               TextWrapping="Wrap"
                               Margin="0,8,0,26" />

                    <TextBlock Text="Email" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding AuthEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                    <TextBlock Text="Mật khẩu" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="PasswordInput" Style="{StaticResource AppPasswordBox}" Margin="0,0,0,22" />

                    <Button Content="Đăng nhập" Click="Login_OnClick" Height="46" Margin="0,0,0,14" />
                    <TextBlock Text="{Binding AuthStatus}"
                               Foreground="{StaticResource MutedInkBrush}"
                               FontSize="13"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Visibility="{Binding SimulatorVisibility}" Background="#F5F7FB">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1"
                    Padding="28,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="46" Height="46" Background="#EFF6FF" CornerRadius="14" Margin="0,0,14,0">
                            <Image Source="Assets/DeviceAppLogo.png" Margin="6" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Device Simulator" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="OmniConnect developer workspace" FontSize="12" Foreground="{StaticResource MutedInkBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="12,7" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SignedInText}" FontSize="12" Foreground="#334155" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button Content="Logout" Click="Logout_OnClick" Style="{StaticResource GhostButton}" Margin="0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="28,24,28,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Your simulated devices" FontSize="26" FontWeight="Bold" Foreground="#0F172A" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="Provision, connect and test devices in real time" Foreground="{StaticResource MutedInkBrush}" />
                        <Border Background="#DBEAFE" CornerRadius="10" Padding="8,2" Margin="10,-2,0,0">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#1D4ED8">
                                <Run Text="{Binding Devices.Count, Mode=OneWay}" /><Run Text=" DEVICES" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding DeviceTypes}"
                                  SelectedItem="{Binding SelectedDeviceType}"
                                  DisplayMemberPath="DisplayName"
                                  Width="220"
                                  Height="38"
                                  Margin="0,0,8,0" />
                        <Button Content="+  Add device" Click="AddDevice_OnClick" Height="38" Margin="0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="28,0,28,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="326"
                                        Background="White"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="18"
                                        Padding="18"
                                        Margin="0,0,14,14">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.06" Color="#475569" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" Background="#EFF6FF" CornerRadius="12">
                                                <Viewbox Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="{Binding IconData}" Stroke="{StaticResource PrimaryBrush}" Style="{StaticResource LucidePath}" />
                                                </Viewbox>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15" Foreground="#0F172A" />
                                                <TextBlock Text="{Binding Serial}" Foreground="{StaticResource MutedInkBrush}" FontSize="11" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{Binding StatusBackground}" CornerRadius="11" Padding="8,4" VerticalAlignment="Top">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Fill="{Binding StatusForeground}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusForeground}" FontSize="11" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,16,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="PAIRING CODE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                                                    <TextBox Text="{Binding PairingCodeDisplay, Mode=OneWay}"
                                                             IsReadOnly="True"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             Foreground="#334155"
                                                             FontWeight="SemiBold"
                                                             Padding="0"
                                                             Margin="0,4,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Copy" Click="CopyPairingCode_OnClick" Tag="{Binding}" Style="{StaticResource MiniButton}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource SettingPanel}" Visibility="{Binding SensorSettingsVisibility}">
                                            <StackPanel>
                                                <TextBlock Text="Sensor range" Style="{StaticResource FieldLabel}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Minimum" FontSize="11" Foreground="{StaticResource MutedInkBrush}" Margin="0,0,0,4" />
                                                        <TextBox Text="{Binding SensorMinValue, UpdateSourceTrigger=PropertyChanged}" Height="34" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Maximum" FontSize="11" Foreground="{StaticResource MutedInkBrush}" Margin="0,0,0,4" />
                                                        <TextBox Text="{Binding SensorMaxValue, UpdateSourceTrigger=PropertyChanged}" Height="34" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingPanel}" Visibility="{Binding ActuatorSettingsVisibility}">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="Initial actuator value" Style="{StaticResource FieldLabel}" />
                                                    <TextBlock Text="State used when the session starts" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                                </StackPanel>
                                                <CheckBox Content="{Binding ActuatorValueText}" IsChecked="{Binding ActuatorValue, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Content="Start" Click="StartDevice_OnClick" Tag="{Binding}" Margin="0,0,8,0" />
                                            <Button Grid.Column="1" Content="Stop" Click="StopDevice_OnClick" Tag="{Binding}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                            <Button Grid.Column="2" Content="Remove" Click="RemoveDevice_OnClick" Tag="{Binding}" Style="{StaticResource DangerButton}" Margin="0" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Column="2" Background="#0F172A" CornerRadius="18" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="28" Height="28" Background="#1E293B" CornerRadius="8" Margin="0,0,9,0">
                                    <TextBlock Text=">_" Foreground="#60A5FA" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Live activity" Foreground="White" FontWeight="SemiBold" />
                                    <TextBlock Text="Session and MQTT events" Foreground="#94A3B8" FontSize="10" />
                                </StackPanel>
                            </StackPanel>
                            <Border Background="#1E293B" CornerRadius="10" Padding="7,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Foreground="#94A3B8" FontSize="10"><Run Text="{Binding Logs.Count, Mode=OneWay}" /><Run Text=" EVENTS" /></TextBlock>
                            </Border>
                        </Grid>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Logs}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#CBD5E1"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="17" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
