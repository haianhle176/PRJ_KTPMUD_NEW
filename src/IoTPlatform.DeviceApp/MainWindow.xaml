<Window x:Class="IoTPlatform.DeviceApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniConnect Device Simulator"
        Width="{Binding AppWindowWidth}"
        Height="{Binding AppWindowHeight}"
        MinWidth="{Binding AppWindowMinWidth}"
        MinHeight="{Binding AppWindowMinHeight}"
        MaxWidth="{Binding AppWindowMaxWidth}"
        MaxHeight="{Binding AppWindowMaxHeight}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/DeviceAppLogo.ico"
        Closing="Window_OnClosing">
    <Grid>
        <Grid Visibility="{Binding AuthVisibility}">
            <Border Background="{StaticResource SurfaceBrush}"
                    Padding="24">
                <StackPanel Width="320" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="Assets/DeviceAppLogo.png"
                           Width="68"
                           Height="68"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Đăng nhập"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Dùng cùng tài khoản với OmniConnect App để thiết bị chỉ hiện trong tài khoản của bạn."
                               Foreground="{StaticResource MutedInkBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,22" />

                    <TextBlock Text="Email" Foreground="{StaticResource MutedInkBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding AuthEmail, UpdateSourceTrigger=PropertyChanged}"
                             Height="40"
                             Padding="12,8"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Mật khẩu" Foreground="{StaticResource MutedInkBrush}" Margin="0,0,0,6" />
                    <PasswordBox x:Name="PasswordInput"
                                 Height="40"
                                 Padding="12,8"
                                 Margin="0,0,0,18" />

                    <Button Content="Đăng nhập"
                            Click="Login_OnClick"
                            Height="42"
                            Margin="0,0,0,12" />
                    <TextBlock Text="{Binding AuthStatus}"
                               Foreground="{StaticResource MutedInkBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Margin="24" Visibility="{Binding SimulatorVisibility}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="130" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/DeviceAppLogo.png"
                       Width="52"
                       Height="52"
                       Margin="0,0,14,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel>
                    <TextBlock Text="Device Simulator" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="Create multiple SmartHome devices and publish them to HiveMQ."
                               Foreground="{StaticResource MutedInkBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding SignedInText}"
                           Foreground="{StaticResource MutedInkBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <ComboBox ItemsSource="{Binding DeviceTypes}"
                          SelectedItem="{Binding SelectedDeviceType}"
                          DisplayMemberPath="DisplayName"
                          Width="220"
                          Height="34"
                          Margin="0,0,10,0" />
                <Button Content="Add device" Click="AddDevice_OnClick" Height="34" />
                <Button Content="Logout"
                        Click="Logout_OnClick"
                        Height="34"
                        Background="White"
                        Foreground="#0F172A"
                        BorderBrush="{StaticResource BorderBrushSoft}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="300"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="16"
                                Margin="0,0,14,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" Background="#EFF6FF" CornerRadius="18">
                                        <Viewbox Width="20"
                                                 Height="20"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Path Data="{Binding IconData}"
                                                  Stroke="{StaticResource PrimaryBrush}"
                                                  Style="{StaticResource LucidePath}" />
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock Text="{Binding Serial}" Foreground="{StaticResource MutedInkBrush}" />
                                    </StackPanel>
                                </Grid>

                                <Border Background="#EFF6FF" CornerRadius="12" Padding="10" Margin="0,14,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding PairingCodeDisplay, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Foreground="{StaticResource MutedInkBrush}"
                                                     Padding="0"
                                                     Margin="0"
                                                     VerticalContentAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Content="Copy"
                                                    Click="CopyPairingCode_OnClick"
                                                    Tag="{Binding}"
                                                    Padding="10,4"
                                                    Margin="8,0,0,0"
                                                    Background="White"
                                                    Foreground="#2563EB"
                                                    BorderBrush="{StaticResource BorderBrushSoft}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F8FAFC"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="10"
                                        Margin="0,0,0,12"
                                        Visibility="{Binding SensorSettingsVisibility}">
                                    <StackPanel>
                                        <TextBlock Text="Sensor range" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Min" Foreground="{StaticResource MutedInkBrush}" />
                                                <TextBox Text="{Binding SensorMinValue, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Max" Foreground="{StaticResource MutedInkBrush}" />
                                                <TextBox Text="{Binding SensorMaxValue, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F8FAFC"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="10"
                                        Margin="0,0,0,12"
                                        Visibility="{Binding ActuatorSettingsVisibility}">
                                    <StackPanel>
                                        <TextBlock Text="Initial actuator value" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <CheckBox Content="{Binding ActuatorValueText}"
                                                  IsChecked="{Binding ActuatorValue, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Start"
                                            Click="StartDevice_OnClick"
                                            Tag="{Binding}" />
                                    <Button Content="Stop"
                                            Click="StopDevice_OnClick"
                                            Tag="{Binding}"
                                            Background="White"
                                            Foreground="#0F172A"
                                            BorderBrush="{StaticResource BorderBrushSoft}" />
                                    <Button Content="Remove"
                                            Click="RemoveDevice_OnClick"
                                            Tag="{Binding}"
                                            Background="White"
                                            Foreground="#DC2626"
                                            BorderBrush="{StaticResource BorderBrushSoft}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="14"
                Margin="0,10,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Log" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ListBox ItemsSource="{Binding Logs}" BorderThickness="0" />
            </DockPanel>
        </Border>
        </Grid>
    </Grid>
</Window>
