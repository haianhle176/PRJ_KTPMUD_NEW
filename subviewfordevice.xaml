<Grid Margin="24">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /> <RowDefinition Height="*" />    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Button Content="← Home > Devices" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
            
            <StackPanel Orientation="Horizontal">
                <Border Width="48" Height="48" Background="#EFF6FF" CornerRadius="12" VerticalAlignment="Top" Margin="0,0,16,0">
                    <Path Data="{StaticResource OmniLogoGeometry}" Fill="#2563EB" Stretch="Fill" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedDevice.HardwareId}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                        <TextBlock Text="Tên:" Foreground="#64748B" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding SelectedDevice.DisplayName}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        
                        <Button Command="{Binding OpenRenameDialogCommand}" 
                                Background="Transparent" BorderBrush="#CBD5E1" BorderThickness="1" 
                                Padding="8,2" CornerRadius="4" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✏️" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Đổi tên" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{Binding StatusColorBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="#64748B" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Button Grid.Column="1" Command="{Binding RefreshDeviceCommand}" Style="{StaticResource IconOnlyButton}" VerticalAlignment="Top">
            <TextBlock Text="↻" FontSize="20" FontWeight="Bold"/>
        </Button>
    </Grid>

    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*" /> <ColumnDefinition Width="3*" /> </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,24,0">
            
            <StackPanel Visibility="{Binding ActuatorAreaVisibility}">
                <TextBlock Text="Controls" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <ItemsControl ItemsSource="{Binding ActuatorsList}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="150" Height="110" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,16,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                                        <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="{Binding IsChecked, ElementName=PowerToggle, Converter={StaticResource BooleanToOnOffConverter}}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="PowerToggle" Grid.Row="2" Style="{StaticResource ModernLeftRightSliderStyle}" IsChecked="{Binding IsActuatorOn}" IsEnabled="{Binding DataContext.IsDeviceOnline, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Visibility="{Binding SensorAreaVisibility}">
                <TextBlock Text="Telemetry" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                
                <Border Visibility="{Binding EmptySensorsVisibility}" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Padding="16" CornerRadius="8">
                    <TextBlock Text="Waiting for simulated telemetry. Start DeviceApp to stream values." Foreground="#1E3A8A" HorizontalAlignment="Center"/>
                </Border>
                
                <ItemsControl ItemsSource="{Binding SensorsList}" Visibility="{Binding HasSensorsVisibility}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="140" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding CapabilityKey}" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                                        <TextBlock Text="{Binding Unit}" FontSize="14" Foreground="#64748B" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border Height="1" Background="{StaticResource BorderBrushSoft}" Margin="0,24,0,24"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Telemetry Log" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="(100 recent events)" Foreground="#64748B" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="Clear" Command="{Binding ClearLogsCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"/>
                </Grid>
                
                <DataGrid Grid.Row="1" ItemsSource="{Binding TelemetryLogs}" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" BorderThickness="1" BorderBrush="#E2E8F0" Background="White" RowBackground="White" MaxHeight="300" IsReadOnly="True" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Timestamp" Binding="{Binding RecordedAt, StringFormat={}{0:HH:mm:ss}}" Width="120" Foreground="#64748B"/>
                        <DataGridTextColumn Header="Capability" Binding="{Binding CapabilityName}" Width="160" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding DisplayValue}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Column="1">
            
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Device summary" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Border Background="#DCFCE7" HorizontalAlignment="Left" Padding="8,4" CornerRadius="6" Margin="0,0,0,12">
                        <TextBlock Text="Simulated Device" Foreground="#16A34A" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="Serial:" Foreground="#64748B" FontSize="12"/>
                    <TextBlock Text="{Binding SelectedDevice.Serial}" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Advanced tools" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Button Content="Manage device" Command="{Binding ManageDeviceCommand}" Margin="0,0,0,8" Height="36"/>
                    <Button Content="View raw telemetry" Command="{Binding ViewRawTelemetryCommand}" Height="36"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Grid>