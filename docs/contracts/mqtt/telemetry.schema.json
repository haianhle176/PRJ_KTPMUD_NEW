{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iot-platform.local/schemas/mqtt/telemetry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["messageId", "serial", "timestampUtc", "schemaVersion", "readings"],
  "properties": {
    "messageId": { "$ref": "common.schema.json#/$defs/messageId" },
    "serial": { "$ref": "common.schema.json#/$defs/serial" },
    "timestampUtc": { "$ref": "common.schema.json#/$defs/timestampUtc" },
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "readings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capabilityKey", "value"],
        "properties": {
          "capabilityKey": { "$ref": "common.schema.json#/$defs/capabilityKey" },
          "value": { "$ref": "common.schema.json#/$defs/dynamicValue" }
        }
      }
    }
  }
}
